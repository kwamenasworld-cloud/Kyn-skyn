  }

  .cc-trust__container {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 3rem;
  }

  .cc-trust__item {
    display: flex;
    align-items: center;
