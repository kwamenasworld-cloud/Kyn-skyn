    opacity: 0.85;
  }

  .cc-what__body p + p { margin-top: 1.2rem; }
  .cc-what__body em { font-style: italic; }

  /* ========== SYMPTOMS ========== */
  .cc-symptoms {
    background: var(--dark);
    color: var(--cream);
    padding: 6rem 3rem;
  }

  .cc-symptoms__container {
    max-width: 56rem;
    margin: 0 auto;
  }

  .cc-symptoms__heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 400;
