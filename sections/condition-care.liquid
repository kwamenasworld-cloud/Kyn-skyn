  .cc-faq__icon {
    flex-shrink: 0;
    width: 18px; height: 18px;
    transition: transform 0.3s;
    opacity: 0.55;
  }

  .cc-faq__item[open] .cc-faq__icon { transform: rotate(45deg); opacity: 1; }

  .cc-faq__answer {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--cream);
    opacity: 0.7;
    padding: 0 0 1.6rem;
  }

  .cc-faq__answer p + p { margin-top: 0.9rem; }

  /* ========== FINAL CTA ========== */
  .cc-final {
    background: var(--cream);
    padding: 7rem 3rem;
    text-align: center;
  }

  .cc-final__container { max-width: 40rem; margin: 0 auto; }

  .cc-final__heading {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--maroon);
    margin-bottom: 1.4rem;
  }

  .cc-final__sub {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--maroon);
    opacity: 0.7;
    margin-bottom: 2.5rem;
  }

  .cc-final__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.1rem 2.4rem;
    background: var(--button);
    color: var(--cream);
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
  }

  .cc-final__cta:hover {
    background: var(--maroon);
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -14px rgba(100, 18, 32, 0.5);
  }

  .cc-final__cta svg { width: 18px; height: 18px; transition: transform 0.3s; }
  .cc-final__cta:hover svg { transform: translateX(3px); }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1024px) {
    .cc-hero__motif { display: none; }
  }

  @media (max-width: 768px) {
    .cc-hero { padding: 6rem 1.5rem 4rem; min-height: 0; }
    .cc-payoff { padding: 3rem 1.5rem; }
    .cc-payoff__grid { grid-template-columns: 1fr; gap: 2rem; }
    .cc-trust { padding: 1.5rem; }
    .cc-trust__container { gap: 1rem 1.5rem; }
    .cc-trust__item { font-size: 0.7rem; }
    .cc-what { padding: 4rem 1.5rem; }
    .cc-symptoms { padding: 4rem 1.5rem; }
    .cc-treatment { padding: 4rem 1.5rem; }
    .cc-treatment__container { grid-template-columns: 1fr; gap: 2rem; }
    .cc-pricing { padding: 4rem 1.5rem; }
    .cc-process { padding: 4rem 1.5rem; }
    .cc-process__grid { grid-template-columns: 1fr 1fr; gap: 1rem; }
    .cc-faq { padding: 4rem 1.5rem; }
    .cc-final { padding: 5rem 1.5rem; }
  }

  @media (max-width: 520px) {
    .cc-process__grid { grid-template-columns: 1fr; }
  }
</style>

