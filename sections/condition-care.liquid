  /* ========== FAQ ========== */
  .cc-faq {
    background: var(--dark);
    color: var(--cream);
    padding: 6rem 3rem;
  }

  .cc-faq__container { max-width: 44rem; margin: 0 auto; }

  .cc-faq__heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
