{% comment %}
  Universal condition care page. Drives /pages/fungal-acne,
  /pages/seb-derm-dandruff, and /pages/tinea-versicolor from a single
  section file. All condition-specific copy is set in the case block
  at the top; the rest of the section uses those variables.

  Structure (light, product-brand):
    1. Hero
    2. Trust bar
    3. What it is (short plain-language explainer)
    4. Managing it (3 steps: Handbook / Ingredient Checker / shop)
    5. Final CTA (shop + waitlist)
    6. Disclaimer
{% endcomment %}

{%- case page.handle -%}
  {%- when 'fungal-acne' -%}
    {%- assign condition_name = 'Fungal Acne' -%}
    {%- assign condition_subtitle = "Tiny, itchy bumps that won't go away." -%}
    {%- assign hero_heading = 'Manage the bumps.' -%}
    {%- assign hero_sub = "Fungal acne is a chronic, Malassezia-driven condition, and most regular acne products feed the yeast behind it. Learn what's actually going on, then build a Malassezia-safe routine from our collection of solutions that help manage symptoms." -%}
    {%- assign whatitis_heading = 'A yeast condition that looks like acne' -%}
    {%- assign whatitis_p1 = '<em>Malassezia folliculitis</em> is an inflammatory infection of the hair follicle caused by <em>Malassezia</em>, a yeast that lives on nearly all human skin. When the local environment shifts, the yeast can overgrow inside the follicle and trigger an immune response. The result is a cluster of small, often itchy bumps people mistake for acne.' -%}
    {%- assign whatitis_p2 = 'Standard acne treatments do not target yeast and often make fungal acne worse. Many of them also contain ingredients <em>Malassezia</em> feeds on. Years of misdiagnosis is the rule, not the exception.' -%}
    {%- comment -%} Deep-links the shop concern filter. {%- endcomment -%}
    {%- assign concern_param = 'fungal-acne' -%}
    {%- assign final_cta_heading = 'Ready to stop feeding it?' -%}
    {%- assign final_cta_sub = 'Shop our collection of Malassezia-safe solutions that help manage symptoms without feeding the yeast behind them.' -%}
    {%- assign cc_hero_bg = 'cond-bg-fungal-acne.jpg' -%}
    {%- assign cc_hero_bg_width = '1800' -%}
    {%- assign cc_hero_bg_height = '1800' -%}
    {%- assign cc_hero_bg_position = '50% 50%' -%}

  {%- when 'seb-derm-dandruff' -%}
    {%- assign condition_name = 'Seb Derm & Dandruff' -%}
    {%- assign condition_subtitle = "Flaky patches and an itchy scalp that won't quit." -%}
    {%- assign hero_heading = 'Manage the flakes.' -%}
    {%- assign hero_sub = "Seborrheic dermatitis and dandruff are chronic, Malassezia-driven conditions, and plenty of regular hair and skin products make them worse. Learn why it flares, then build a Malassezia-safe routine from our collection of solutions that help manage flaking and itch." -%}
    {%- assign whatitis_heading = 'Inflammation triggered by yeast in oily skin' -%}
    {%- assign whatitis_p1 = 'Seborrheic dermatitis is a chronic inflammatory condition driven by <em>Malassezia</em>, the same yeast behind fungal acne and dandruff. It typically shows up where your skin produces the most oil: scalp, around the nose, eyebrows, behind the ears, and the upper chest.' -%}
    {%- assign whatitis_p2 = 'Dandruff is essentially scalp seb derm with less inflammation. They sit on the same spectrum, respond to the same treatment, and the line between them is fuzzy.' -%}
    {%- comment -%} Deep-links the shop concern filter. {%- endcomment -%}
    {%- assign concern_param = 'seb-derm-dandruff' -%}
    {%- assign final_cta_heading = 'Get out of the flake-and-flare loop.' -%}
    {%- assign final_cta_sub = 'Shop our collection of Malassezia-safe solutions that help manage flakes and itch, and keep your routine from working against you.' -%}
    {%- assign cc_hero_bg = 'cond-bg-seb-derm.jpg' -%}
    {%- assign cc_hero_bg_width = '1200' -%}
    {%- assign cc_hero_bg_height = '1800' -%}
    {%- assign cc_hero_bg_position = '50% 50%' -%}

  {%- when 'tinea-versicolor' -%}
    {%- assign condition_name = 'Tinea Versicolor' -%}
    {%- assign condition_subtitle = "Spots that won't tan with the rest of your skin." -%}
    {%- assign hero_heading = 'Manage the patches.' -%}
    {%- assign hero_sub = "Tinea versicolor is a chronic, Malassezia-driven condition that thrives in heat and humidity. Learn what's actually going on, then build a Malassezia-safe maintenance routine from our collection of solutions that help manage symptoms between seasons." -%}
    {%- assign whatitis_heading = "Yeast that disrupts the skin's pigment production" -%}
    {%- assign whatitis_p1 = 'Tinea versicolor is caused by <em>Malassezia</em> overgrowing on the skin and producing compounds that interfere with melanin production in the affected areas. The result is patches that are lighter or darker than your surrounding skin, often most visible after sun exposure.' -%}
    {%- assign whatitis_p2 = "It's common and harmless to your overall health. Once the yeast is back under control, the discoloration still takes time to even out, since pigment production needs time to recover." -%}
    {%- comment -%} No shop product is tagged tinea-versicolor yet; restore concern_param when one lands. {%- endcomment -%}
    {%- assign final_cta_heading = 'Get ahead of next season.' -%}
    {%- assign final_cta_sub = 'Shop our collection of solutions that support a Malassezia-safe maintenance routine, so hot months do not catch you off guard.' -%}
    {%- assign cc_hero_bg = 'cond-bg-tinea-versicolor.jpg' -%}
    {%- assign cc_hero_bg_width = '1800' -%}
    {%- assign cc_hero_bg_height = '1800' -%}
    {%- assign cc_hero_bg_position = '50% 50%' -%}

{%- endcase -%}

<style>
  /* ========== HERO ========== */
  .cc-hero {
    position: relative;
    padding: 9rem 3rem 6rem;
    background: linear-gradient(165deg, var(--dark) 0%, var(--maroon) 130%);
    color: var(--cream);
    overflow: hidden;
    min-height: 32rem;
    display: flex;
    align-items: center;
  }

  .cc-hero__container {
    position: relative;
    z-index: 3;
    max-width: 64rem;
    margin: 0 auto;
    width: 100%;
  }

  /* Per-condition photographic background. Sits below the gradient overlay
     so cream text remains legible on the left side, image breathes through
     on the right. */
  .cc-hero__bg-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .cc-hero__bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cc-hero__bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(95deg,
        rgba(15, 4, 6, 0.96) 0%,
        rgba(42, 2, 8, 0.88) 38%,
        rgba(42, 2, 8, 0.7) 70%,
        rgba(42, 2, 8, 0.78) 100%);
  }

  /* 3D plus-grid motif on the right side of the hero. Static, decorative. */
  .cc-hero__motif {
    position: absolute;
    top: 0;
    right: -6rem;
    bottom: 0;
    width: clamp(28rem, 48vw, 52rem);
    z-index: 2;
    pointer-events: none;
    perspective: 1600px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cc-hero__motif-stack {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(18deg) rotateY(-28deg);
  }

  .cc-hero__motif-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .cc-hero__motif-layer--back {
    color: var(--terracotta);
    opacity: 0.22;
    transform: translateZ(-80px) scale(1.18);
    filter: blur(4px);
  }

  .cc-hero__motif-layer--mid {
    color: var(--gold);
    opacity: 0.45;
    transform: translateZ(-35px) scale(1.07);
  }

  .cc-hero__motif-layer--front {
    color: var(--gold);
    opacity: 0.85;
    filter: drop-shadow(0 24px 40px rgba(199, 91, 42, 0.4));
  }

  /* Condition-specific molecule on the left of the hero. Brand-palette
     only (cream / gold / deep-gold), single drop-shadow matching the
     plus-grid motif's front layer so the two background objects sit in
     the same visual world. */
  .cc-hero__condition-icon {
    position: absolute;
    top: 50%;
    left: 2rem;
    width: clamp(10rem, 13vw, 15rem);
    aspect-ratio: 1;
    transform: translateY(-50%) perspective(900px) rotateX(15deg) rotateY(18deg);
    z-index: 2;
    pointer-events: none;
    opacity: 0.5;
  }

  .cc-hero__condition-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .cc-hero__tag {
    display: inline-block;
    margin-bottom: 1.2rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(212, 149, 42, 0.5);
    border-radius: 999px;
    background: rgba(212, 149, 42, 0.1);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .cc-hero__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.4rem;
  }

  .cc-hero__heading {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.5vw, 4.5rem);
    font-weight: 300;
    line-height: 1.05;
    margin-bottom: 1.6rem;
    max-width: 36rem;
  }

  .cc-hero__sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    opacity: 0.78;
    max-width: 40rem;
    margin-bottom: 1.75rem;
  }

  .cc-hero__sub em { font-style: italic; }

  .cc-hero__actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .cc-hero__plans-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--cream);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .cc-hero__plans-link:hover { opacity: 1; }

  .cc-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1.05rem 2rem;
    background: var(--cream);
    color: var(--maroon);
    font-family: var(--font-accent);
    font-size: 0.92rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cc-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -12px rgba(0,0,0,0.6);
  }

  .cc-hero__cta svg { width: 18px; height: 18px; transition: transform 0.3s; }
  .cc-hero__cta:hover svg { transform: translateX(3px); }

  /* ========== MANAGING IT ========== */
  .cc-payoff {
    background: var(--cream);
    padding: clamp(4.5rem, 7vw, 6.5rem) 3rem;
  }

  .cc-payoff__container {
    max-width: 74rem;
    margin: 0 auto;
  }

  .cc-payoff__kicker {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 1rem;
    text-align: center;
  }

  .cc-payoff__eyebrow {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.15rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: 0;
    text-transform: none;
    color: var(--maroon);
    opacity: 1;
    margin: 0 auto clamp(3.5rem, 6vw, 5rem);
    text-align: center;
    max-width: 54rem;
  }

  .cc-payoff__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .cc-payoff__item {
    min-width: 0;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
  }

  .cc-payoff__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.75rem;
    height: 5.75rem;
    margin: 0 0 1.45rem;
    border: 1px solid rgba(212, 149, 42, 0.45);
    border-radius: 999px;
    background: rgba(255, 244, 206, 0.52);
    color: var(--maroon);
  }

  .cc-payoff__icon svg {
    width: 3.55rem;
    height: 3.55rem;
    display: block;
    overflow: visible;
  }

  .cc-payoff__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(212, 149, 42, 0.65);
    border-radius: 999px;
    background: rgba(212, 149, 42, 0.1);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    color: var(--maroon);
    margin: 0 0 0.85rem;
  }

  .cc-payoff__title {
    font-family: var(--font-sans);
    font-size: clamp(1.28rem, 2vw, 1.55rem);
    line-height: 1.15;
    color: var(--maroon);
    margin: 0 0 0.85rem;
    font-weight: 600;
  }

  .cc-payoff__desc {
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.35vw, 1.1rem);
    line-height: 1.58;
    color: var(--dark);
    opacity: 0.78;
    margin: 0;
  }

  .cc-payoff__desc em { font-style: italic; }

  .cc-payoff__desc a {
    color: var(--maroon);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  /* ========== TRUST BAR ========== */
  .cc-trust {
    background: var(--dark);
    border-top: 1px solid rgba(255, 244, 206, 0.06);
    border-bottom: 1px solid rgba(255, 244, 206, 0.06);
    padding: 1.8rem 3rem;
  }

  .cc-trust__container {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 3rem;
  }

  .cc-trust__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.6;
  }

  .cc-trust__item svg { width: 16px; height: 16px; color: var(--gold); }

  /* ========== EXPLAINER (What it is) ========== */
  .cc-explainer {
    background: var(--cream);
    padding: clamp(4rem, 7vw, 6rem) 3rem clamp(3.5rem, 6vw, 5rem);
  }

  .cc-explainer__container {
    max-width: 44rem;
    margin: 0 auto;
  }

  .cc-explainer__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.5vw, 2.75rem);
    font-weight: 300;
    line-height: 1.12;
    color: var(--maroon);
    margin: 0 0 1.6rem;
    text-align: center;
  }

  .cc-explainer__body p {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.7;
    color: var(--dark);
    opacity: 0.82;
    margin: 0 0 1.1rem;
  }

  .cc-explainer__body em { font-style: italic; }

  /* ========== FINAL CTA ========== */
  .cc-final {
    background: linear-gradient(165deg, var(--dark) 0%, var(--maroon) 130%);
    color: var(--cream);
    padding: clamp(4rem, 7vw, 6rem) 3rem;
    text-align: center;
  }

  .cc-final__container { max-width: 40rem; margin: 0 auto; }

  .cc-final__heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    line-height: 1.1;
    margin: 0 0 1.2rem;
  }

  .cc-final__sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.65;
    opacity: 0.8;
    margin: 0 0 2rem;
  }

  .cc-final .cc-hero__plans-link {
    display: block;
    margin-top: 1.4rem;
  }

  /* ========== DISCLAIMER ========== */
  .cc-disclaimer {
    background: var(--cream);
    padding: 2.2rem 3rem;
    border-top: 1px solid rgba(42, 2, 8, 0.08);
  }

  .cc-disclaimer__container { max-width: 52rem; margin: 0 auto; }

  .cc-disclaimer__container p {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--maroon);
    opacity: 0.62;
    margin: 0;
    text-align: center;
  }

  /* ========== REDUCED MOTION ========== */
  @media (prefers-reduced-motion: reduce) {
    .cc-hero__cta,
    .cc-hero__cta:hover,
    .cc-hero__cta svg {
      transition: none !important;
      transform: none !important;
    }
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 1024px) {
    .cc-hero__motif,
    .cc-hero__condition-icon { display: none; }
  }

  @media (max-width: 768px) {
    .cc-hero { padding: 6rem 1.5rem 4rem; min-height: 0; }
    .cc-payoff { padding: 3rem 1.5rem; }
    .cc-payoff__eyebrow { margin-bottom: 2.75rem; }
    .cc-payoff__grid { grid-template-columns: 1fr; gap: 2.6rem; }
    .cc-payoff__icon { width: 5.75rem; height: 5.75rem; margin-bottom: 1.2rem; }
    .cc-trust { padding: 1.5rem; }
    .cc-trust__container { gap: 1rem 1.5rem; }
    .cc-trust__item { font-size: 0.7rem; }
    .cc-explainer { padding: 3rem 1.5rem 2.5rem; }
    .cc-final { padding: 3.5rem 1.5rem; }
    .cc-disclaimer { padding: 2rem 1.5rem; }
  }

  </style>

<!-- ====== HERO ====== -->
