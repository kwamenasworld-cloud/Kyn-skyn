        <source type="image/webp" srcset="{{ cc_hero_bg | replace: '.jpg', '.webp' | asset_url }}">
        <img src="{{ cc_hero_bg | asset_url }}" alt="" width="{{ cc_hero_bg_width }}" height="{{ cc_hero_bg_height }}" loading="eager" fetchpriority="high" decoding="async" style="object-position: {{ cc_hero_bg_position | default: 'center' }};">
      </picture>
    </div>
    <div class="cc-hero__bg-overlay" aria-hidden="true"></div>
  {%- endif -%}
  <div class="cc-hero__motif" aria-hidden="true">
    <div class="cc-hero__motif-stack">
      <svg class="cc-hero__motif-layer cc-hero__motif-layer--back" viewBox="0 0 462 462" aria-hidden="true"><path d="{{ cc_motif_path }}" fill="currentColor"/></svg>
      <svg class="cc-hero__motif-layer cc-hero__motif-layer--mid" viewBox="0 0 462 462" aria-hidden="true"><path d="{{ cc_motif_path }}" fill="currentColor"/></svg>
      <svg class="cc-hero__motif-layer cc-hero__motif-layer--front" viewBox="0 0 462 462" aria-hidden="true"><path d="{{ cc_motif_path }}" fill="currentColor"/></svg>
    </div>
  </div>
  <div class="cc-hero__condition-icon" aria-hidden="true">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        {%- comment -%}
          Brand-palette gradient: cream highlight (--cream) -> gold (--gold)
          -> deep-gold edge. No white, no black. Matches the plus-grid
          motif's restraint.
        {%- endcomment -%}
        <radialGradient id="ccAtom" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#fff4ce"/>
          <stop offset="45%" stop-color="#d4952a"/>
          <stop offset="100%" stop-color="#7a4a14"/>
        </radialGradient>
        <radialGradient id="ccAtomSm" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#fff4ce"/>
          <stop offset="45%" stop-color="#d4952a"/>
          <stop offset="100%" stop-color="#7a4a14"/>
        </radialGradient>
        {%- comment -%}
          Single soft terracotta drop-shadow — same recipe as
          .cc-hero__motif-layer--front so both background objects share
          one source of depth.
        {%- endcomment -%}
        <filter id="ccMolFx" x="-30%" y="-20%" width="160%" height="150%">
          <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#c75b2a" flood-opacity="0.4"/>
        </filter>
      </defs>
      {%- comment -%} Cylindrical bond — 3 concentric strokes so each bond reads as a lit cylinder rather than a flat ribbon. Coords substituted per bond below. {%- endcomment -%}
      {%- capture cc_bond -%}<g><line stroke="#7a4a14" stroke-width="4" stroke-linecap="round" x1="X1" y1="Y1" x2="X2" y2="Y2"/><line stroke="#d4952a" stroke-width="2" stroke-linecap="round" x1="X1" y1="Y1" x2="X2" y2="Y2"/></g>{%- endcapture -%}
      {%- if page.handle == 'fungal-acne' -%}
        <g filter="url(#ccMolFx)">
          {%- comment -%} Tetrahedral molecule — central atom with four satellites {%- endcomment -%}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '22' | replace: 'Y2', '24' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '78' | replace: 'Y2', '24' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '22' | replace: 'Y2', '78' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '78' | replace: 'Y2', '78' }}
          <g><circle cx="22" cy="24" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="78" cy="24" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="22" cy="78" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="78" cy="78" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="50" cy="50" r="15" fill="url(#ccAtom)"/></g>
        </g>
      {%- elsif page.handle == 'seb-derm-dandruff' -%}
        <g filter="url(#ccMolFx)">
          {%- comment -%} Hexagonal ring — benzene-style with two side substituents {%- endcomment -%}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '14' | replace: 'X2', '78' | replace: 'Y2', '30' }}
          {{ cc_bond | replace: 'X1', '78' | replace: 'Y1', '30' | replace: 'X2', '78' | replace: 'Y2', '62' }}
          {{ cc_bond | replace: 'X1', '78' | replace: 'Y1', '62' | replace: 'X2', '50' | replace: 'Y2', '78' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '78' | replace: 'X2', '22' | replace: 'Y2', '62' }}
          {{ cc_bond | replace: 'X1', '22' | replace: 'Y1', '62' | replace: 'X2', '22' | replace: 'Y2', '30' }}
          {{ cc_bond | replace: 'X1', '22' | replace: 'Y1', '30' | replace: 'X2', '50' | replace: 'Y2', '14' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '14' | replace: 'X2', '50' | replace: 'Y2', '4' }}
          {{ cc_bond | replace: 'X1', '78' | replace: 'Y1', '62' | replace: 'X2', '90' | replace: 'Y2', '70' }}
          <g><circle cx="50" cy="14" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="78" cy="30" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="78" cy="62" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="50" cy="78" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="22" cy="62" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="22" cy="30" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="50" cy="4" r="6" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="90" cy="70" r="6" fill="url(#ccAtomSm)"/></g>
        </g>
      {%- elsif page.handle == 'tinea-versicolor' -%}
        <g filter="url(#ccMolFx)">
          {%- comment -%} Branched chain — pigment-like structure {%- endcomment -%}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '50' | replace: 'Y2', '18' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '22' | replace: 'Y2', '68' }}
          {{ cc_bond | replace: 'X1', '50' | replace: 'Y1', '50' | replace: 'X2', '78' | replace: 'Y2', '68' }}
          {{ cc_bond | replace: 'X1', '22' | replace: 'Y1', '68' | replace: 'X2', '22' | replace: 'Y2', '92' }}
          {{ cc_bond | replace: 'X1', '78' | replace: 'Y1', '68' | replace: 'X2', '92' | replace: 'Y2', '84' }}
          <g><circle cx="50" cy="50" r="13" fill="url(#ccAtom)"/></g>
          <g><circle cx="50" cy="18" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="22" cy="68" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="78" cy="68" r="9" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="22" cy="92" r="6" fill="url(#ccAtomSm)"/></g>
          <g><circle cx="92" cy="84" r="6" fill="url(#ccAtomSm)"/></g>
        </g>
      {%- endif -%}
    </svg>
  </div>

