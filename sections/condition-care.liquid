    margin-bottom: 1rem;
    text-align: center;
  }

  .cc-symptoms__sub {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    text-align: center;
    opacity: 0.6;
    margin-bottom: 3rem;
  }

  .cc-symptoms__list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 36rem;
    margin: 0 auto;
  }

  .cc-symptoms__list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgba(255, 244, 206, 0.08);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--cream);
    opacity: 0.85;
  }

  .cc-symptoms__list li:last-child { border-bottom: none; }

  .cc-symptoms__check {
    flex-shrink: 0;
