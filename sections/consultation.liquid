<script>
  // Express checkout mode: when ?checkout=1 is in the URL, the home page
  // landed us here for the sole purpose of starting intake. Set a class on
  // <html> BEFORE any styled HTML renders so the hero/conditions/steps/FAQ
  // sections never flash visible. The iframe auto-opens at the top of the
  // page (see the KynCareFlow IIFE below).
  if (typeof URLSearchParams !== 'undefined') {
    var __kynCheckoutParams = new URLSearchParams(window.location.search);
    if (__kynCheckoutParams.get('checkout') === '1') {
      document.documentElement.classList.add('kyn-checkout-mode');
      // A preselected plan will auto-open after KynCareFlow initializes.
      // Do not mark intake open here; that can reveal an empty iframe if
      // a later script is delayed or fails.
    }
  }
</script>

<style>
  /* ========== EXPRESS CHECKOUT MODE ========== */
  .kyn-checkout-mode .th-hero,
  .kyn-checkout-mode .th-conditions,
  .kyn-checkout-mode .th-steps,
  .kyn-checkout-mode #secure-intake,
  .kyn-checkout-mode .th-faq,
  .kyn-checkout-mode .th-care-flow__header,
  .kyn-checkout-mode footer.site-footer,
  .kyn-checkout-mode .mobile-tab-bar { display: none !important; }
  /* Tighten the pricing section in checkout mode while leaving enough room
     for trust copy and the one-time consult option. */
  .kyn-checkout-mode #th-pricing {
    padding: clamp(5.25rem, 7vw, 6.25rem) 1.5rem 2.5rem !important;
  }
  /* When the intake opens in checkout mode, take over the whole
     viewport. The previous layout left the iframe boxed under the fixed
     site header + a big section padding + the plan bar, which squeezed
     it shorter than the wizard content and forced an inner scrollbar.
     Now: lock the body, hide the header + pricing, pin the care flow to
     the full screen as a flex column, and let the iframe fill every
     pixel below the thin plan bar. dvh (not vh) so mobile browser chrome
     doesn't push the bottom off-screen. */
  .kyn-checkout-mode.kyn-intake-open body { overflow: hidden !important; }
  .kyn-checkout-mode.kyn-intake-open .site-header { display: none !important; }
  .kyn-checkout-mode.kyn-intake-open #th-pricing { display: none !important; }
  .kyn-checkout-mode.kyn-intake-open .th-care-flow {
    position: fixed !important;
    inset: 0 !important;
    z-index: 100000 !important;
    margin: 0 !important;
    padding: 0 !important;
    height: 100dvh !important;
    display: flex !important;
    flex-direction: column !important;
  }
  .kyn-checkout-mode.kyn-intake-open .th-care-flow__container {
    max-width: none !important;
    margin: 0 !important;
    flex: 1 1 auto !important;
    min-height: 0 !important;
    display: flex !important;
    flex-direction: column !important;
  }
  /* Drop the big eyebrow/title/copy block in takeover mode — the plan
