<script>
  (function() {
    var plans = document.querySelectorAll('.th-plan');
    var augmentInput = document.querySelector('.th-plan__augment-input[data-augment="quarterly"]');

    // Determine effective plan: selected card, overridden to quarterly if Monthly + augment checkbox
    function getEffectivePlan() {
      var selected = document.querySelector('.th-plan.th-plan--selected');
      var plan = selected ? selected.getAttribute('data-plan') : 'monthly';
      if (plan === 'monthly' && augmentInput && augmentInput.checked) return 'quarterly';
      return plan;
    }

    plans.forEach(function(plan) {
      plan.addEventListener('click', function(e) {
        // Don't hijack clicks inside the augment toggle label
        if (e.target && e.target.closest && e.target.closest('.th-plan__augment')) return;
        plans.forEach(function(p) {
          p.classList.remove('th-plan--selected');
          p.setAttribute('aria-checked', 'false');
        });
        plan.classList.add('th-plan--selected');
        plan.setAttribute('aria-checked', 'true');
        // Switching to a non-Monthly card clears the quarterly augment
        if (augmentInput && plan.getAttribute('data-plan') !== 'monthly') {
          augmentInput.checked = false;
          renderMonthlyPrice();
        }
        // Click on a plan card immediately opens secure intake. No
        // intermediate "Start checkout" or "Open secure checkout" buttons.
        if (window.KynCareFlow) {
          window.KynCareFlow.open(getEffectivePlan());
        }
      });
    });

    if (augmentInput) {
      augmentInput.addEventListener('change', function() {
        // Turning on the augment forces the Monthly card to be selected.
        // Plan does NOT auto-open from a toggle change - the user must
        // still click the Monthly card to commit to quarterly.
        if (augmentInput.checked) {
          plans.forEach(function(p) {
            var isMonthly = p.getAttribute('data-plan') === 'monthly';
            p.classList.toggle('th-plan--selected', isMonthly);
            p.setAttribute('aria-checked', isMonthly ? 'true' : 'false');
          });
        }
      });
    }

    var requestedPlan = new URLSearchParams(window.location.search).get('plan');
    var oneTimeDisclosure = document.querySelector('.th-onetime');
    var isCheckoutMode = document.documentElement.classList.contains('kyn-checkout-mode');

    if (requestedPlan === 'quarterly' && augmentInput) {
      augmentInput.checked = true;
      plans.forEach(function(p) {
        var isMonthly = p.getAttribute('data-plan') === 'monthly';
        p.classList.toggle('th-plan--selected', isMonthly);
        p.setAttribute('aria-checked', isMonthly ? 'true' : 'false');
      });
    } else if (requestedPlan === 'one-time') {
      plans.forEach(function(p) {
        var isTarget = p.getAttribute('data-plan') === 'one-time';
        p.classList.toggle('th-plan--selected', isTarget);
        p.setAttribute('aria-checked', isTarget ? 'true' : 'false');
      });
      if (augmentInput) augmentInput.checked = false;
      // Reveal the disclosure so the pre-selected one-time card is visible.
      if (oneTimeDisclosure) oneTimeDisclosure.open = true;
    } else if (!requestedPlan) {
      // No plan choice made yet (ads / organic): default to quarterly
      // billing. Month-1 contribution on monthly is ~$8.82 after the
      // clinician case fee, so undecided paid traffic starts on the
      // 3-month plan. renderMonthlyPrice() keeps the card's headline
      // honest ($74.99/3 mo while the toggle is on), so the price a
      // visitor clicks is always the price they're billed.
      plans.forEach(function(p) {
        var isMonthly = p.getAttribute('data-plan') === 'monthly';
        p.classList.toggle('th-plan--selected', isMonthly);
        p.setAttribute('aria-checked', isMonthly ? 'true' : 'false');
      });
      if (augmentInput) augmentInput.checked = true;
      if (isCheckoutMode && oneTimeDisclosure) oneTimeDisclosure.open = true;
    } else {
      // Explicit 'monthly' or any unrecognized plan value (e.g. a typo'd
      // condition-page link): plain monthly with the billing toggle off.
      // An explicit monthly pick must never silently bill quarterly.
      plans.forEach(function(p) {
        var isMonthly = p.getAttribute('data-plan') === 'monthly';
        p.classList.toggle('th-plan--selected', isMonthly);
        p.setAttribute('aria-checked', isMonthly ? 'true' : 'false');
      });
      if (augmentInput) augmentInput.checked = false;
      if (isCheckoutMode && oneTimeDisclosure) oneTimeDisclosure.open = true;
    }

    // Keep the membership card's headline price in sync with the billing
    // toggle so the clicked price always equals the billed price. Values
    // mirror the hardcoded plan prices in the markup; keep in sync with
    // Stripe (STRIPE_PRICE_MONTHLY / _QUARTERLY).
    function renderMonthlyPrice() {
      var monthlyCard = document.querySelector('.th-plan[data-plan="monthly"]');
      if (!monthlyCard || !augmentInput) return;
      var priceEl = monthlyCard.querySelector('.th-plan__price');
      if (!priceEl) return;
      priceEl.innerHTML = augmentInput.checked
        ? '$74.99<span class="th-plan__price-suffix">/3 mo</span>'
        : '$29.99<span class="th-plan__price-suffix">/mo</span>';
    }
    renderMonthlyPrice();
    if (augmentInput) augmentInput.addEventListener('change', renderMonthlyPrice);

  })();
</script>

