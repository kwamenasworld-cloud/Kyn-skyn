    .th-waitlist__form { flex-direction: column; }
    .th-waitlist__input { width: 100%; }
    .th-waitlist__button { width: 100%; }
  }
</style>

<script>
  (function() {
    var pricingCta = document.getElementById('thPricingCta');
    var plans = document.querySelectorAll('.th-plan');
    var augmentInput = document.querySelector('.th-plan__augment-input[data-augment="quarterly"]');
    var CTA_LABELS = {
      'monthly': 'Continue with Monthly · $[price]/mo',
      'quarterly': 'Continue with 3-Month Plan · $[price]/3 mo',
      'one-time': 'Book One-time Consult · $[price]'
    };

    function readPrice(selector) {
      var el = document.querySelector(selector);
      if (!el) return '';
      var clone = el.cloneNode(true);
      var suffix = clone.querySelector('.th-plan__price-suffix');
      if (suffix) suffix.parentNode.removeChild(suffix);
      return clone.textContent.replace(/[^0-9.]/g, '');
    }

    // Determine effective plan: selected card, overridden to quarterly if Monthly + augment checkbox
    function getEffectivePlan() {
      var selected = document.querySelector('.th-plan.th-plan--selected');
      var plan = selected ? selected.getAttribute('data-plan') : 'monthly';
      if (plan === 'monthly' && augmentInput && augmentInput.checked) return 'quarterly';
      return plan;
    }

    function setPricingCta() {
      // No-op while the page is in pre-launch waitlist mode.
      // The CTA stays as a static scroll link to #th-waitlist.
    }

    plans.forEach(function(plan) {
      plan.addEventListener('click', function(e) {
        // Don't hijack clicks inside the augment toggle label
        if (e.target && e.target.closest && e.target.closest('.th-plan__augment')) return;
        plans.forEach(function(p) {
          p.classList.remove('th-plan--selected');
          p.setAttribute('aria-checked', 'false');
        });
        plan.classList.add('th-plan--selected');
        plan.setAttribute('aria-checked', 'true');
        // Switching to a non-Monthly card clears the quarterly augment
        if (augmentInput && plan.getAttribute('data-plan') !== 'monthly') {
          augmentInput.checked = false;
        }
        setPricingCta();
      });
    });

    if (augmentInput) {
      augmentInput.addEventListener('change', function() {
        // Turning on the augment forces the Monthly card to be selected
        if (augmentInput.checked) {
          plans.forEach(function(p) {
            var isMonthly = p.getAttribute('data-plan') === 'monthly';
            p.classList.toggle('th-plan--selected', isMonthly);
            p.setAttribute('aria-checked', isMonthly ? 'true' : 'false');
          });
        }
        setPricingCta();
      });
    }
  })();
</script>


<!-- ====== WAITLIST ====== -->
<section class="th-cta" id="th-waitlist">
  <div class="th-cta__container fade-in">
    <p class="th-waitlist__eyebrow">Opening June 1, 2026</p>
    <h2 class="th-cta__heading">Be first in line.</h2>
    <p class="th-cta__desc">Join the Kyn Skyn Rx waitlist and we'll email you the moment booking opens. Waitlist members get <strong>$20 off their first 3-month plan</strong>: $74.99 becomes $54.99 for your provider consultation and ongoing care. If your clinician writes a prescription, it's sent to your pharmacy of choice and billed there.</p>
    <form class="th-waitlist__form" id="thWaitlistForm" novalidate>
      <input type="email" class="th-waitlist__input" name="EMAIL" placeholder="you@email.com" required aria-label="Email address">
      <button type="submit" class="th-waitlist__button">Join the waitlist</button>
    </form>
    <p class="th-waitlist__note" id="thWaitlistNote" aria-live="polite"></p>
    <p class="th-cta__note">One email when we launch.</p>
  </div>
</section>

<script>
  // ── Waitlist form submission ──
  (function () {
    var form = document.getElementById('thWaitlistForm');
    if (!form) return;
    var input = form.querySelector('input[type="email"]');
    var btn = form.querySelector('.th-waitlist__button');
    var note = document.getElementById('thWaitlistNote');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = input.value.trim();
      if (!input.checkValidity()) {
        note.textContent = 'Enter a valid email address.';
        note.style.color = '#b02a2a';
        input.focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Joining...';
      note.textContent = '';

      try {
        await window.KynWaitlist.submit({
          email: email,
          source: 'consultation-waitlist-quarterly-20off'
        });

        btn.textContent = "You're on the list";
        btn.style.background = '#2a6e3f';
        btn.style.borderColor = '#2a6e3f';
        btn.style.color = '#ffffff';
        note.textContent = "We'll email you on June 1 with your $20-off code.";
        note.style.color = '#2a6e3f';
        input.value = '';
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Join the waitlist';
        note.textContent = err && err.message ? err.message : 'Something went wrong. Please try again.';
        note.style.color = '#b02a2a';
      }
    });
  })();
</script>

<!-- ====== FAQ ====== -->
<section class="th-faq">
  <div class="th-faq__container">
    <h2 class="th-faq__heading fade-in">Common questions</h2>

    <!-- FAQ:START -->
    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">What conditions can I get diagnosed for?</button>
      <div class="th-faq__a"><p>Three conditions, all driven by the same <em>Malassezia</em> yeast: fungal acne (Malassezia folliculitis), seb derm and dandruff (same condition; dandruff is just scalp seb derm), and tinea versicolor. Generic acne or eczema treatments tend to miss because they don't target yeast.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How does the consultation work?</button>
      <div class="th-faq__a"><p>Every consultation starts async. A licensed provider (MD, DO, or NP) reviews your intake and photos and sends you a written diagnosis and treatment plan, usually within 48 hours, with follow-up questions in the same thread. If you'd rather speak with your clinician live, you can request a video call from your dashboard for an extra $15. Most people stay async; the video option is there if you want it.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">Can I get a prescription?</button>
      <div class="th-faq__a"><p>Yes. If your provider decides a prescription is the right call, they e-prescribe it straight to your pharmacy. That typically means a topical antifungal (e.g., ketoconazole), depending on what you have.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">Is this covered by insurance?</button>
      <div class="th-faq__a"><p>It depends on your plan. A lot of insurers do cover virtual dermatology visits, but some don't, so call yours before you book.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How is my health information protected?</button>
      <div class="th-faq__a"><p>All consultations run on a HIPAA-compliant platform. Your medical records are encrypted at rest and in transit, and we don't share them with third parties. We also keep the care platform entirely separate from the shop, so your clinical data never sits next to your order history.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">I already used the Ingredient Checker. Should I still book?</button>
      <div class="th-faq__a"><p>The Ingredient Checker flags products that may be feeding Malassezia, but it can't diagnose you. A provider can tell you whether it's actually fungal acne, seb derm, or tinea versicolor, and they can prescribe the antifungals you can't buy over the counter.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How much does a consultation cost?</button>
      <div class="th-faq__a"><p>Treatment Plans are $29.99 a month, or $74.99 every 3 months (about $25 a month). Both cover your provider consultation and your prescription, sent to the pharmacy you select during booking. A one-time consult is $34.99. Payment runs securely through Stripe.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">Do I need to upload photos of my skin?</button>
      <div class="th-faq__a"><p>Yes. Please add at least 2 photos during intake; you can attach up to 5. If you skip them, your clinician will likely message you for photos before they can diagnose, which adds 1 to 2 days to your wait. We strip GPS and device metadata before storing them. Access is limited to your treating clinician and authorized Kyn Skyn care staff.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How do I select a pharmacy?</button>
      <div class="th-faq__a"><p>During booking, you search for pharmacies by name and ZIP code. If your provider prescribes anything, the e-prescription is sent to whichever pharmacy you picked.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">What payment methods do you accept?</button>
      <div class="th-faq__a"><p>All payments run through Stripe. We take major credit and debit cards (Visa, Mastercard, Amex, Discover), plus Apple Pay and Google Pay.</p></div>
    </div>
    <!-- FAQ:END -->
  </div>
</section>

<script>
  document.querySelectorAll('.th-faq__q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var answer = this.nextElementSibling;
      var isOpen = answer.classList.contains('open');
      document.querySelectorAll('.th-faq__a').forEach(function(a) { a.classList.remove('open'); });
      document.querySelectorAll('.th-faq__q').forEach(function(q) { q.classList.remove('active'); });
      if (!isOpen) {
        answer.classList.add('open');
        this.classList.add('active');
      }
    });
  });

  // Pricing is intentionally hardcoded in this section's Liquid markup.
  // Stripe is the source of truth for what the customer is charged
  // (STRIPE_PRICE_MONTHLY / STRIPE_PRICE_QUARTERLY / STRIPE_PRICE_ONETIME).
  // When prices change, update the Liquid above to match Stripe and push.
</script>

