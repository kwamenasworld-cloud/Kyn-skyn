      <p class="th-flow__eyebrow">Your secure Kynsultation</p>
      <h2 class="th-care-flow__title">Your Kynsultation.</h2>
      <p class="th-care-flow__copy">Photos, consent, pharmacy choice, and payment all happen inside the secure care flow. Pick a different plan above if you want to switch.</p>
    </div>

    <div class="th-care-flow__shell">
      <div class="th-care-flow__bar">
        <a href="{{ routes.root_url }}" class="th-care-flow__bar-logo" aria-label="Kyn Skyn home">
          <img src="{{ 'kyn-skyn-logoword-black.svg' | asset_url }}" alt="Kyn Skyn" width="388" height="181" loading="lazy">
        </a>
        <p class="th-care-flow__bar-note" id="thCareFlowPlan">Kyn Care Membership selected</p>
      </div>

      <div class="th-care-flow__frame-wrap" id="thCareFlowFrameWrap">
        <iframe
          class="th-care-flow__frame"
          id="thCareFlowFrame"
          title="Kyn Skyn secure care checkout"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="camera; clipboard-write; payment"
        ></iframe>
      </div>

      <div class="th-care-flow__success" id="thCareFlowSuccess" hidden>
        Your case was submitted. Check your email for next steps and sign-in details.
      </div>
    </div>
  </div>
</section>

<script>
  window.KynCareFlow = (function() {
    var CARE_ORIGIN = 'https://care.kynskyn.com';
    var frame = document.getElementById('thCareFlowFrame');
    var frameWrap = document.getElementById('thCareFlowFrameWrap');
    var success = document.getElementById('thCareFlowSuccess');
    var planLabel = document.getElementById('thCareFlowPlan');
    var section = document.getElementById('th-care-flow');

    function normalizePlan(plan) {
      if (plan === 'quarterly' || plan === 'one-time') return plan;
      return 'monthly';
    }

    function planName(plan) {
      if (plan === 'quarterly') return 'Kyn Care Membership, 3-month billing selected';
      if (plan === 'one-time') return 'One-time consult selected';
      return 'Kyn Care Membership selected';
    }

    function currentPlan() {
      var selected = document.querySelector('.th-plan.th-plan--selected');
      var plan = selected ? selected.getAttribute('data-plan') : 'monthly';
      var augment = document.querySelector('.th-plan__augment-input[data-augment="quarterly"]');
      if (plan === 'monthly' && augment && augment.checked) return 'quarterly';
      return normalizePlan(plan);
    }

    var initiateCheckoutTracked = false;

    function trackInitiateCheckout() {
      if (initiateCheckoutTracked) return;
      initiateCheckoutTracked = true;

      var attempts = 0;
      function send() {
        attempts += 1;
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'InitiateCheckout');
          return;
        }
        if (attempts < 20) {
          window.setTimeout(send, 250);
        }
      }

      send();
    }

    var purchaseTracked = false;

    // Fired when the care flow reports a completed booking. We keep ALL Meta
    // Pixel contact on the storefront (this is the ad-attributed domain that
    // already fired InitiateCheckout); the care app only reports a non-PHI
    // pricing tier. We send value + currency only -- never any clinical data.
    // Prices mirror the hardcoded ones in the pricing/FAQ markup; keep in sync
    // with Stripe (STRIPE_PRICE_MONTHLY / _QUARTERLY / _ONETIME).
    function trackPurchase(plan, reportedValue, eventId) {
      if (purchaseTracked) return;
      purchaseTracked = true;

      var prices = { monthly: 29.99, quarterly: 74.99, 'one-time': 40 };
      // Prefer the real charged amount the care flow reports (drift-proof);
      // fall back to the displayed plan price so value is never missing.
      var value = (typeof reportedValue === 'number' && reportedValue > 0)
        ? reportedValue
        : ((typeof prices[plan] === 'number') ? prices[plan] : prices[currentPlan()]);

      // Shared dedup key (the care case id) so a future server-side
      // Conversions API Purchase with the same eventID is not double-counted.
      var options = eventId ? { eventID: String(eventId) } : undefined;

      var attempts = 0;
      function send() {
        attempts += 1;
        if (typeof window.fbq === 'function') {
          var payload = { currency: 'USD' };
          if (typeof value === 'number') payload.value = value;
          window.fbq('track', 'Purchase', payload, options);
          return;
        }
        if (attempts < 20) {
          window.setTimeout(send, 250);
        }
      }

      send();
    }

    function buildCareUrl(plan) {
      var target = new URL(CARE_ORIGIN + '/book');
      var params = new URLSearchParams(window.location.search);
      var ctx = window.KynAttribution ? window.KynAttribution.capture() : {};
      var traffic = window.KynAttribution && window.KynAttribution.trafficAttribution
        ? window.KynAttribution.trafficAttribution()
        : {};
      target.searchParams.set('source', 'kynskyn');
      target.searchParams.set('plan', normalizePlan(plan));
      target.searchParams.set('embed', 'shopify');
      target.searchParams.set('parent_origin', window.location.origin);
      if (window.KynAttribution && window.KynAttribution.sessionId) {
        target.searchParams.set('kyn_session_id', window.KynAttribution.sessionId());
      }

      var preview = params.get('booking_preview');
      if (preview) target.searchParams.set('booking_preview', preview);
      if (ctx.affiliatebase_referral) target.searchParams.set('affiliatebase_referral', ctx.affiliatebase_referral);
      ['traffic_source', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'referrer_host'].forEach(function(key) {
        if (traffic[key]) target.searchParams.set(key, traffic[key]);
      });
      // Forward the Meta Pixel cookies (_fbp / _fbc, set by fbevents.js on this
      // domain) so the care app's server-side Conversions API Purchase matches
      // the same browser. No-op when absent.
      var fbpMatch = document.cookie.match(/(?:^|;\s*)_fbp=([^;]+)/);
      if (fbpMatch) target.searchParams.set('fbp', decodeURIComponent(fbpMatch[1]));
      var fbcMatch = document.cookie.match(/(?:^|;\s*)_fbc=([^;]+)/);
      if (fbcMatch) target.searchParams.set('fbc', decodeURIComponent(fbcMatch[1]));
      return target.toString();
    }

    function open(plan) {
      plan = normalizePlan(plan || currentPlan());
      if (planLabel) planLabel.textContent = planName(plan);
      trackInitiateCheckout();
      if (frame) frame.setAttribute('src', buildCareUrl(plan));
      if (success) success.hidden = true;
      if (frameWrap) frameWrap.hidden = false;
      var inCheckout = document.documentElement.classList.contains('kyn-checkout-mode');
      if (section) {
        section.hidden = false;
        // Express checkout mode: the iframe is already at the top of the
        // page (hero + steps + pricing are hidden). No scroll needed.
        // Normal mode: smooth-scroll into view from wherever the user is.
        if (!inCheckout) {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      if (inCheckout) {
        // Mark the page so the (otherwise visible) pricing section collapses.
        document.documentElement.classList.add('kyn-intake-open');
      }
    }

    window.addEventListener('message', function(event) {
      if (event.origin !== CARE_ORIGIN) return;
      var data = event.data || {};
      if (data.type === 'kyn_intake_resize' && frame && data.height) {
        // In checkout mode the iframe is a full-viewport takeover sized
        // purely by CSS (height:100% of the fixed pane). Clear any inline
        // height so it doesn't fight the CSS; the iframe content scrolls
        // internally only if a wizard page is taller than the screen.
        var inCheckout = document.documentElement.classList.contains('kyn-checkout-mode');
        if (inCheckout) {
          frame.style.height = '';
          return;
        }
        // Normal embedded mode (care flow on a scrollable page): grow the
        // iframe to its content, capped at the viewport, so the outer page
        // never gets a nested scrollbar.
        var viewportCap = Math.max(window.innerHeight - 200, 480);
        var hardCap = Math.min(viewportCap, 900);
        var next = Math.min(Math.max(Number(data.height) || 480, 480), hardCap);
        frame.style.height = next + 'px';
      }
      if (data.type === 'kyn_payment_complete') {
        if (frameWrap) frameWrap.hidden = true;
        if (success) success.hidden = false;
        trackPurchase(data.plan, data.value, data.event_id);
      }
    });

    // A condition page can send users here with ?plan=...&checkout=1.
    // Open directly from inside this IIFE so open() is guaranteed to exist
    // before checkout mode hides pricing and shows the iframe.
    var qs = new URLSearchParams(window.location.search);
    if (qs.get('checkout') === '1' && qs.get('plan')) {
      open(currentPlan());
    }

    return { open: open };
  })();
</script>

<!-- ====== SECURE INTAKE ====== -->
<section class="th-cta" id="secure-intake">
  <div class="th-cta__container fade-in">
    <p class="th-flow__eyebrow">One secure Kynsultation</p>
    <h2 class="th-cta__heading">Your Kynsultation, in one secure place.</h2>
    <p class="th-cta__desc">Pick your plan here, then the embedded care flow collects your intake, consent, photos, pharmacy choice, and payment in one place. Clinical answers never live on the storefront.</p>
    <a href="#th-pricing" class="th-cta__button">Pick your Kynsultation</a>
  </div>
</section>

<!-- ====== FAQ ====== -->
<section class="th-faq">
  <div class="th-faq__container">
    <h2 class="th-faq__heading fade-in">Common questions</h2>

    <!-- FAQ:START -->
    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">What conditions can I get diagnosed for?</button>
      <div class="th-faq__a"><p>Three conditions, all driven by the same <em>Malassezia</em> yeast: fungal acne (Malassezia folliculitis), seb derm and dandruff (same condition; dandruff is just scalp seb derm), and tinea versicolor. Generic acne or eczema treatments tend to miss because they don't target yeast.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How does the consultation work?</button>
      <div class="th-faq__a"><p>Every consultation starts async. A board-certified dermatologist reviews your intake and photos and sends you a written diagnosis and treatment plan, usually within 48 hours, with follow-up questions in the same thread. If you'd rather speak with your clinician live, you can request a video call from your dashboard for an extra $15. Most people stay async; the video option is there if you want it.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">Can I get a prescription?</button>
      <div class="th-faq__a"><p>Yes. If your provider decides a prescription is the right call, they e-prescribe it straight to your pharmacy. That typically means a topical antifungal (e.g., ketoconazole), depending on what you have.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">Is this cash pay only?</button>
      <div class="th-faq__a"><p>Yes. Kyn Skyn is cash pay only. We do not bill insurance, so you pay directly at checkout before your provider reviews your intake.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How is my health information protected?</button>
      <div class="th-faq__a"><p>Plan selection and attribution start on KynSkyn.com, but your medical intake, photos, messages, payment step, and provider records are handled by the secure care backend. We do not store clinical answers or skin photos in Shopify order data.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">I already used the Ingredient Checker. Should I still book?</button>
      <div class="th-faq__a"><p>The Ingredient Checker flags products that may be feeding Malassezia, but it can't diagnose you. A provider can tell you whether it's actually fungal acne, seb derm, or tinea versicolor, and they can prescribe the antifungals you can't buy over the counter.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How much does a consultation cost?</button>
      <div class="th-faq__a"><p>Treatment Plans are $29.99 a month, or $74.99 every 3 months (about $25 a month). A one-time Kynsultation is $40. Your plan covers the dermatologist visit, your treatment plan, and sending any prescription to the pharmacy you choose. You pay for the medication itself at your pharmacy, and most antifungals we prescribe are inexpensive generics like ketoconazole. Payment happens at the end of intake in the secure care flow.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">Do I need to upload photos of my skin?</button>
      <div class="th-faq__a"><p>Yes. Please add at least 2 photos during intake; you can attach up to 5. If you skip them, your clinician will likely message you for photos before they can diagnose, which adds 1 to 2 days to your wait. We strip GPS and device metadata before storing them. Access is limited to your treating clinician and authorized Kyn Skyn care staff.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">How do I select a pharmacy?</button>
      <div class="th-faq__a"><p>During intake, you search for pharmacies by name and ZIP code. If your provider prescribes anything, the e-prescription is sent to whichever pharmacy you picked.</p></div>
    </div>

    <div class="th-faq__item fade-in">
      <button class="th-faq__q" type="button">What payment methods do you accept?</button>
      <div class="th-faq__a"><p>We accept major credit and debit cards. Payment happens at the end of intake in the secure care flow.</p></div>
    </div>
    <!-- FAQ:END -->
  </div>
</section>

<script>
  document.querySelectorAll('.th-faq__q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var answer = this.nextElementSibling;
      var isOpen = answer.classList.contains('open');
      document.querySelectorAll('.th-faq__a').forEach(function(a) { a.classList.remove('open'); });
      document.querySelectorAll('.th-faq__q').forEach(function(q) { q.classList.remove('active'); });
      if (!isOpen) {
        answer.classList.add('open');
        this.classList.add('active');
      }
    });
  });

  // Pricing is intentionally hardcoded in this section's Liquid markup.
  // Stripe is the source of truth for what the customer is charged
  // (STRIPE_PRICE_MONTHLY / STRIPE_PRICE_QUARTERLY / STRIPE_PRICE_ONETIME).
  // When prices change, update the Liquid above to match Stripe and push.
</script>

