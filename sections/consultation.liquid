<script>
  // Consultations are retired on the storefront. Send anyone landing on an
  // old consultation link straight to the shop, keeping any query params.
  window.location.replace('/pages/shop' + window.location.search);
</script>

<style>
  .consult-redirect {
    background: var(--cream);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 1.5rem 4rem;
  }

  .consult-redirect__inner {
    max-width: 32rem;
  }

  .consult-redirect__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 300;
    color: var(--maroon);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .consult-redirect__link {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--maroon);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<!-- No-JS fallback: visible notice with a plain link to the shop. -->
<section class="consult-redirect">
  <div class="consult-redirect__inner">
    <h1 class="consult-redirect__heading">Kyn Skyn has a new home for solutions</h1>
    <a href="/pages/shop" class="consult-redirect__link">Shop our solutions</a>
  </div>
</section>

{% schema %}
{
  "name": "Consultation",
  "class": "consultation-section",
  "settings": []
}
{% endschema %}
