  }
  .th-plan__augment-input:checked::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 0px;
    width: 3px;
    height: 6px;
    border: solid #641220;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .th-plan__augment-label { display: block; }
  .th-plan__augment-title {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: #F8B044;
    letter-spacing: 0.02em;
  }
  .th-plan__augment-detail {
    display: block;
    font-size: 0.65rem;
    color: rgba(255, 244, 206, 0.55);
    margin-top: 0.1rem;
  }

  /* ── Waitlist form (on cream section background) ── */
  .th-waitlist__eyebrow {
    display: inline-block;
    font-family: var(--font-accent, 'STK Bureau Sans', sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--maroon);
    background: rgba(248, 176, 68, 0.18);
    border: 1px solid rgba(100, 18, 32, 0.25);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    margin-bottom: 1.2rem;
  }
  .th-waitlist__form {
    display: flex;
    gap: 0.5rem;
    max-width: 480px;
    margin: 1.8rem auto 0.5rem;
    flex-wrap: wrap;
  }
  .th-waitlist__input {
    flex: 1;
    min-width: 220px;
    padding: 0.9rem 1.1rem;
    font-family: var(--font-sans, 'STK Bureau Sans', sans-serif);
    font-size: 0.95rem;
    background: #ffffff;
    border: 1px solid rgba(100, 18, 32, 0.3);
    border-radius: 4px;
    color: var(--dark);
  }
  .th-waitlist__input::placeholder { color: rgba(61, 32, 37, 0.4); }
  .th-waitlist__input:focus { outline: none; border-color: var(--maroon); box-shadow: 0 0 0 3px rgba(100, 18, 32, 0.08); }
  .th-waitlist__button {
    padding: 0.9rem 1.8rem;
    font-family: var(--font-sans, 'STK Bureau Sans', sans-serif);
    font-size: 0.8rem;
