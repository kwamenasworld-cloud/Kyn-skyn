    flex: 1 1 auto !important;
    min-height: 0 !important;
    display: flex !important;
  }
  /* Fill the pane. !important beats the JS inline height set by the
     resize handler, which we also short-circuit in checkout mode. */
  .kyn-checkout-mode.kyn-intake-open .th-care-flow__frame {
    flex: 1 1 auto !important;
