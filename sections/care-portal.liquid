{%- comment -%}
  Embedded care portal. Full-bleed takeover: the care.kynskyn.com app (its full
  dashboard / messages / care pulse / plan / account portal) fills the viewport.
  The Shopify site header and footer are hidden on this page so the care app's
  own header is the only chrome (single logo); its header carries a kynskyn.com
  link back to the store. Only the iframe scrolls. Kyn Select "Add to routine"
  on the in-app Plan page posts kyn_add_to_cart to this parent, which writes to
  THIS Shopify cart (origin-validated) for native checkout. Inline only.
{%- endcomment -%}

<section class="kyn-portal" id="kynPortal">
  <iframe
    class="kyn-portal__frame"
    id="kynPortalFrame"
    title="Kyn Skyn care portal"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="camera; clipboard-write; payment"></iframe>

  <div class="kyn-portal__cartbar" id="kynPortalCartBar" hidden>
    <span class="kyn-portal__cartmsg" id="kynPortalCartMsg">Added to your cart.</span>
    <a class="kyn-portal__cartbtn" href="/cart" id="kynPortalCartBtn">Review and check out</a>
  </div>
</section>

<style>
  /* Hide the marketing header + footer on this page so the embedded care app
     owns the screen and there is only one logo. The mobile tab bar (no logo)
     stays for site navigation. */
  .site-header { display: none !important; }
  .site-footer { display: none !important; }
  /* Pinned to the viewport (top:0 since the site header is hidden) down to the
     mobile tab bar; JS sets the exact offsets. The page body has no flow
     content, so it never scrolls; only the iframe scrolls. */
  .kyn-portal {
    position: fixed;
    left: 0; right: 0; top: 0; bottom: 0;
    background: var(--dark);
    overflow: hidden;
    z-index: 1;
  }
  .kyn-portal__frame {
    display: block; width: 100%; height: 100%; border: 0; background: var(--dark);
  }
  .kyn-portal__cartbar {
    position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 2;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    background: var(--maroon); color: var(--cream);
    border-radius: 14px; padding: 14px 18px;
    box-shadow: 0 12px 40px rgba(42, 2, 8, .45);
  }
  .kyn-portal__cartmsg { font-size: 15px; }
  .kyn-portal__cartbtn {
    background: var(--cream); color: var(--maroon); text-decoration: none;
    font-weight: 600; padding: 10px 18px; border-radius: 10px; white-space: nowrap;
  }
  .kyn-portal__cartbtn:hover { background: #fff; }
</style>

<script>
  (function () {
    var CARE_ORIGIN = 'https://care.kynskyn.com';
    var section = document.getElementById('kynPortal');
    var frame = document.getElementById('kynPortalFrame');
    var cartBar = document.getElementById('kynPortalCartBar');
    var cartMsg = document.getElementById('kynPortalCartMsg');

    function buildPortalUrl() {
      var target = new URL(CARE_ORIGIN + '/dashboard');
      target.searchParams.set('source', 'kynskyn');
      target.searchParams.set('parent_origin', window.location.origin);
      var preview = new URLSearchParams(window.location.search).get('booking_preview');
      if (preview) target.searchParams.set('booking_preview', preview);
      return target.toString();
    }
    if (frame) frame.setAttribute('src', buildPortalUrl());

    // Fill the viewport between the (hidden) header and the mobile tab bar so
    // the outer page never scrolls; the iframe scrolls its own content. With
    // the site header hidden its measured height is 0, so the embed starts at
    // the very top.
    function fitFrame() {
      if (!section) return;
      var header = document.getElementById('siteHeader');
      var headerH = header ? Math.round(header.getBoundingClientRect().height) : 0;
      var tabbar = document.querySelector('.mobile-tab-bar');
      var tabbarH = (tabbar && getComputedStyle(tabbar).display !== 'none')
        ? Math.round(tabbar.getBoundingClientRect().height) : 0;
      section.style.top = headerH + 'px';
      section.style.bottom = tabbarH + 'px';
    }
    fitFrame();
    window.addEventListener('resize', fitFrame);
    window.addEventListener('orientationchange', fitFrame);
    window.addEventListener('load', fitFrame);
    setTimeout(fitFrame, 300);

    // Only pass through string properties with a leading underscore plus a size
    // cap, so a stray or malicious message can't stuff arbitrary cart-line data.
    function sanitizeProps(props) {
      var out = {};
      if (props && typeof props === 'object') {
        Object.keys(props).slice(0, 10).forEach(function (k) {
          if (typeof k !== 'string' || k.length > 64) return;
          var v = props[k];
          if (typeof v === 'string' && v.length <= 200) out[k] = v;
        });
      }
      return out;
    }

    function showCartBar(count) {
      if (!cartBar) return;
      if (cartMsg) {
        cartMsg.textContent = count
          ? 'Added to your cart (' + count + ' item' + (count === 1 ? '' : 's') + ').'
          : 'Added to your cart.';
      }
      cartBar.hidden = false;
    }

    function showCartError() {
      if (!cartBar) return;
      if (cartMsg) cartMsg.textContent = 'We could not add that to your cart. Please try again.';
      cartBar.hidden = false;
    }

    function addToCart(items) {
      if (!Array.isArray(items) || !items.length) return;
      var payload = items.map(function (it) {
        return {
          id: it && it.variantId,
          quantity: Math.max(1, parseInt(it && it.quantity, 10) || 1),
          properties: sanitizeProps(it && it.properties)
        };
      }).filter(function (it) { return it.id; });
      if (!payload.length) return;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: payload })
      }).then(function (res) {
        if (!res.ok) throw new Error('add failed');
        return fetch('/cart.js');
      }).then(function (res) { return res.json(); })
        .then(function (cart) {
          if (frame && frame.contentWindow) {
            frame.contentWindow.postMessage(
              { type: 'kyn_cart_updated', cart_count: cart.item_count },
              CARE_ORIGIN
            );
          }
          showCartBar(cart.item_count);
        })
        .catch(function () { showCartError(); });
    }

    window.addEventListener('message', function (event) {
      if (event.origin !== CARE_ORIGIN) return;
      var data = event.data || {};
      if (data.type === 'kyn_add_to_cart') {
        addToCart(data.items);
      }
    });
  })();
</script>
