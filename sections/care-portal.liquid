{%- comment -%}
  Care portal redirect. The portal is no longer embedded on the storefront;
  existing patients who bookmarked /pages/care-portal are sent straight to the
  live app at care.kynskyn.com. The notice below is the visible fallback if the
  redirect script does not run. Inline style/script only.
{%- endcomment -%}

<script>window.location.replace('https://care.kynskyn.com/dashboard' + window.location.search);</script>

<style>
  .portal-redirect {
    background: var(--cream);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 1.5rem 4rem;
  }

  .portal-redirect__inner {
    max-width: 32rem;
  }

  .portal-redirect__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 300;
    color: var(--maroon);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .portal-redirect__link {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--maroon);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<!-- No-JS fallback: visible notice with a plain link to the care portal. -->
<section class="portal-redirect">
  <div class="portal-redirect__inner">
    <h1 class="portal-redirect__heading">Looking for your Kyn care portal?</h1>
    <a href="https://care.kynskyn.com/dashboard" class="portal-redirect__link">Open the care portal</a>
  </div>
</section>

{% schema %}
{
  "name": "Care Portal",
  "class": "care-portal-section",
  "settings": []
}
{% endschema %}
