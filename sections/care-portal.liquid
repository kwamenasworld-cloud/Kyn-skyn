{%- comment -%}
  Embedded care portal. Frames care.kynskyn.com/embed/care so a patient can view
  their treatment plan + Kyn Select recommendations and add Kyn Select products
  to THIS Shopify cart without leaving kynskyn.com. The care iframe is token
  authed (its own storage, no third-party cookies); it posts its content height
  (kyn_intake_resize) and add-to-cart requests (kyn_add_to_cart). We validate the
  message origin, write the cart via /cart/add.js, then reveal a native Shopify
  checkout link. Inline style/script only (assets/ is flat; no external files).
{%- endcomment -%}

<section class="kyn-portal" id="kynPortal">
  <div class="kyn-portal__container">
    <div class="kyn-portal__header">
      <p class="kyn-portal__eyebrow">Your care</p>
      <h1 class="kyn-portal__title">Your treatment plan</h1>
      <p class="kyn-portal__copy">Your prescription plan and your Kyn Select routine in one place. Add Kyn Select items to your cart and check out here on KynSkyn.com.</p>
    </div>

    <div class="kyn-portal__shell">
      <iframe
        class="kyn-portal__frame"
        id="kynPortalFrame"
        title="Kyn Skyn care portal"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="clipboard-write"
      ></iframe>
    </div>

    <div class="kyn-portal__cartbar" id="kynPortalCartBar" hidden>
      <span class="kyn-portal__cartmsg" id="kynPortalCartMsg">Added to your cart.</span>
      <a class="kyn-portal__cartbtn" href="/cart" id="kynPortalCartBtn">Review and check out</a>
    </div>
  </div>
</section>

<style>
  .kyn-portal { background: var(--cream); padding: 32px 16px 56px; }
  .kyn-portal__container { max-width: 880px; margin: 0 auto; }
  .kyn-portal__header { text-align: center; margin-bottom: 20px; }
  .kyn-portal__eyebrow { text-transform: uppercase; letter-spacing: .22em; font-size: 12px; color: var(--maroon); margin: 0 0 8px; }
  .kyn-portal__title { color: var(--maroon); font-size: clamp(28px, 4vw, 40px); margin: 0 0 10px; }
  .kyn-portal__copy { color: var(--maroon); opacity: .8; max-width: 560px; margin: 0 auto; line-height: 1.6; }
  .kyn-portal__shell { border-radius: 20px; overflow: hidden; background: var(--dark); box-shadow: 0 18px 50px rgba(42, 2, 8, .25); }
  .kyn-portal__frame { display: block; width: 100%; min-height: 720px; border: 0; background: var(--dark); }
  .kyn-portal__cartbar {
    position: sticky; bottom: 16px; margin: 16px auto 0;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    background: var(--dark); color: var(--cream); border-radius: 14px; padding: 14px 18px;
    box-shadow: 0 12px 40px rgba(42, 2, 8, .35);
  }
  .kyn-portal__cartmsg { font-size: 15px; }
  .kyn-portal__cartbtn {
    background: var(--cream); color: var(--maroon); text-decoration: none; font-weight: 600;
    padding: 10px 18px; border-radius: 10px; white-space: nowrap;
  }
  .kyn-portal__cartbtn:hover { background: #fff; }
</style>

<script>
  (function () {
    var CARE_ORIGIN = 'https://care.kynskyn.com';
    var frame = document.getElementById('kynPortalFrame');
    var cartBar = document.getElementById('kynPortalCartBar');
    var cartMsg = document.getElementById('kynPortalCartMsg');

    function buildPortalUrl() {
      var target = new URL(CARE_ORIGIN + '/embed/care');
      target.searchParams.set('source', 'kynskyn');
      target.searchParams.set('parent_origin', window.location.origin);
      var preview = new URLSearchParams(window.location.search).get('booking_preview');
      if (preview) target.searchParams.set('booking_preview', preview);
      return target.toString();
    }

    if (frame) frame.setAttribute('src', buildPortalUrl());

    // Only pass through string properties with a leading underscore (Shopify's
    // "hidden" line-item property convention) plus a small size cap, so a stray
    // or malicious message can't stuff arbitrary data onto the cart line.
    function sanitizeProps(props) {
      var out = {};
      if (props && typeof props === 'object') {
        Object.keys(props).slice(0, 10).forEach(function (k) {
          if (typeof k !== 'string' || k.length > 64) return;
          var v = props[k];
          if (typeof v === 'string' && v.length <= 200) out[k] = v;
        });
      }
      return out;
    }

    function showCartBar(count) {
      if (!cartBar) return;
      if (cartMsg) {
        cartMsg.textContent = count
          ? 'Added to your cart (' + count + ' item' + (count === 1 ? '' : 's') + ').'
          : 'Added to your cart.';
      }
      cartBar.hidden = false;
    }

    function showCartError() {
      if (!cartBar) return;
      if (cartMsg) cartMsg.textContent = 'We could not add that to your cart. Please try again.';
      cartBar.hidden = false;
    }

    function addToCart(items) {
      if (!Array.isArray(items) || !items.length) return;
      var payload = items.map(function (it) {
        return {
          id: it && it.variantId,
          quantity: Math.max(1, parseInt(it && it.quantity, 10) || 1),
          properties: sanitizeProps(it && it.properties)
        };
      }).filter(function (it) { return it.id; });
      if (!payload.length) return;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: payload })
      }).then(function (res) {
        if (!res.ok) throw new Error('add failed');
        return fetch('/cart.js');
      }).then(function (res) { return res.json(); })
        .then(function (cart) {
          if (frame && frame.contentWindow) {
            frame.contentWindow.postMessage(
              { type: 'kyn_cart_updated', cart_count: cart.item_count },
              CARE_ORIGIN
            );
          }
          showCartBar(cart.item_count);
        })
        .catch(function () { showCartError(); });
    }

    window.addEventListener('message', function (event) {
      if (event.origin !== CARE_ORIGIN) return;
      var data = event.data || {};
      if (data.type === 'kyn_intake_resize' && frame && data.height) {
        var next = Math.min(Math.max(Number(data.height) || 720, 600), 4000);
        frame.style.height = next + 'px';
      }
      if (data.type === 'kyn_add_to_cart') {
        addToCart(data.items);
      }
    });
  })();
</script>
