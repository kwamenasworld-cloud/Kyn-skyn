<style>
  /* Scoped to .shop-page so it doesn't leak into other templates */
  .shop-page {
    --amber: #F8B044;
    --amber-light: #fbc676;
    --terracotta: #C54427;
  }

  .shop-hero {
    position: relative;
    background: var(--maroon);
    color: var(--cream);
    padding: 4.5rem 1.5rem;
    overflow: hidden;
  }
  .shop-hero__watermark {
    position: absolute;
    inset: 0;
    background-image: url('{{ 'plus-grid.svg' | asset_url }}');
    background-repeat: no-repeat;
    background-position: right -180px top -100px;
    background-size: 620px 620px;
    opacity: 0.06;
    pointer-events: none;
  }
  .shop-hero__inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }
  .shop-hero__head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .shop-hero__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--amber);
    margin: 0 0 0.6rem 0;
  }
  .shop-hero__title {
    font-family: var(--font-accent);
    font-size: 3rem;
    line-height: 1.05;
    color: var(--cream);
    margin: 0 0 0.75rem 0;
  }
  .shop-hero__subtitle {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--cream);
    opacity: 0.85;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .shop-hero__featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Amber-on-maroon package mockup - echoes the actual Steady Serum box */
  .shop-mockup {
    aspect-ratio: 1;
    position: relative;
    background: var(--maroon);
    border: 1px solid rgba(255, 244, 206, 0.15);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    overflow: hidden;
  }
  .shop-mockup__brand {
    position: absolute;
    top: 1.8rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--amber);
    opacity: 0.75;
  }
  .shop-mockup__name {
    text-align: center;
    line-height: 0.95;
  }
  .shop-mockup__name-top {
    font-family: var(--font-accent);
    font-size: 4rem;
    color: var(--amber);
    margin: 0;
  }
  .shop-mockup__divider {
    height: 1px;
    width: 4rem;
    background: var(--amber);
    opacity: 0.4;
    margin: 0.8rem auto;
  }
  .shop-mockup__name-bottom {
    font-family: var(--font-accent);
    font-size: 2.6rem;
    color: var(--amber);
    opacity: 0.92;
    margin: 0;
  }
  .shop-mockup__size {
    position: absolute;
    bottom: 1.8rem;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--cream);
    opacity: 0.5;
  }

  .shop-featured__cta-wrap {
    position: relative;
    display: inline-block;
  }

  .shop-featured__sticker {
    position: absolute;
    top: -14px;
    left: -14px;
    transform: rotate(-8deg);
    transform-origin: center;
    z-index: 3;
    display: inline-block;
    background: var(--dark);
    color: var(--cream);
    border: 1.5px solid rgba(255, 244, 206, 0.45);
    border-radius: 2rem;
    font-family: var(--font-accent);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.5rem 1.1rem;
    box-shadow: 0 8px 22px -8px rgba(42, 2, 8, 0.7);
    pointer-events: none;
    white-space: nowrap;
    animation: shopStickerPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s both,
               shopStickerWiggle 6s ease-in-out 2s infinite;
  }

  @keyframes shopStickerPop {
    from { opacity: 0; transform: rotate(-22deg) scale(0.7); }
    to   { opacity: 1; transform: rotate(-8deg) scale(1); }
  }

  @keyframes shopStickerWiggle {
    0%, 100% { transform: rotate(-8deg) translateY(0); }
    50%      { transform: rotate(-6deg) translateY(-2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-featured__sticker { animation: none; transform: rotate(-8deg); }
  }

  /* Product image - replaces the mockup when a featured product is set */
  .shop-featured__image {
    aspect-ratio: 1;
    background: var(--maroon);
    border: 1px solid rgba(255, 244, 206, 0.15);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shop-featured__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-featured__info { }
  .shop-featured__label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--amber);
    margin: 0 0 0.5rem 0;
  }
  .shop-featured__name {
    font-family: var(--font-accent);
    font-size: 2.6rem;
    color: var(--cream);
    line-height: 1.05;
    margin: 0 0 0.8rem 0;
  }
  .shop-featured__price {
    font-family: var(--font-accent);
    font-size: 1.75rem;
    color: var(--amber);
    margin: 0 0 1.25rem 0;
  }
  .shop-featured__desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--cream);
    opacity: 0.92;
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
  }
  .shop-featured__desc p { margin: 0 0 0.85rem 0; }
  .shop-featured__desc p:last-child { margin-bottom: 0; }
  .shop-featured__btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    background: var(--amber);
    color: var(--maroon);
    border: none;
    padding: 0.9rem 2.5rem;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
  }
  .shop-featured__btn:hover { background: var(--amber-light); }
  .shop-featured__btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .shop-featured__note {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--cream);
    opacity: 0.7;
    margin: 0.85rem 0 0 0;
  }

  /* Alternate CTA - shown when the featured product is not configured */
  .shop-featured__cta-wrap--restock {
    display: block;
    max-width: 400px;
  }
  .shop-restock-form {
    display: flex;
    gap: 0.5rem;
    margin: 0.5rem 0 0 0;
    flex-wrap: wrap;
  }
  .shop-restock-form__input {
    flex: 1;
    min-width: 200px;
    padding: 0.9rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    border: 1px solid rgba(255, 244, 206, 0.25);
    border-radius: 10px;
    background: rgba(255, 244, 206, 0.05);
    color: var(--cream);
    outline: none;
  }
  .shop-restock-form__input::placeholder { color: rgba(255, 244, 206, 0.4); }
  .shop-restock-form__input:focus { border-color: var(--amber); }
  .shop-restock-form__btn {
    padding: 0.9rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    background: var(--amber);
    color: var(--maroon);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .shop-restock-form__btn:hover { background: var(--amber-light); }
  .shop-restock-form__btn:disabled { opacity: 0.85; cursor: default; }
  .shop-restock-form__note {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--cream);
    opacity: 0.6;
    line-height: 1.5;
    margin: 0.65rem 0 0 0;
  }
  .shop-restock-form__note--success { color: #b6e4c2; opacity: 0.95; }
  .shop-restock-form__note--error { color: #e8725a; opacity: 0.95; }

  @media (max-width: 640px) {
    .shop-restock-form { flex-direction: column; }
    .shop-restock-form__input { width: 100%; }
    .shop-restock-form__btn { width: 100%; }
  }

  /* Two-product Kyn Select grid (replaces the single featured product) */
  .shop-products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 300px));
    justify-content: center;
    gap: 1.5rem;
    max-width: 760px;
    margin: 0 auto;
  }
  .shop-product-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 244, 206, 0.04);
    border: 1px solid rgba(255, 244, 206, 0.15);
    border-radius: 18px;
    overflow: hidden;
  }
  .shop-product-card__image {
    display: block;
    aspect-ratio: 1;
    background: rgba(255, 244, 206, 0.03);
    overflow: hidden;
  }
  .shop-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .shop-product-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .shop-product-card__name {
    font-family: var(--font-accent);
    font-size: 1.2rem;
    line-height: 1.15;
    color: var(--cream);
    margin: 0;
  }
  .shop-product-card__name a { color: inherit; text-decoration: none; }
  .shop-product-card__name a:hover { text-decoration: underline; }
  .shop-product-card__price {
    font-family: var(--font-accent);
    font-size: 1.1rem;
    color: var(--amber);
    margin: 0;
  }
  .shop-product-card__desc {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--cream);
    opacity: 0.7;
    margin: 0.15rem 0 0.7rem;
  }
  .shop-product-card__btn {
    margin-top: auto;
    display: block;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--amber);
    color: var(--maroon);
    border: none;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s;
  }
  .shop-product-card__btn:hover { background: var(--amber-light); }
  .shop-product-card__btn--disabled { opacity: 0.55; cursor: not-allowed; }
  @media (max-width: 640px) {
    .shop-products { grid-template-columns: 1fr; max-width: 360px; }
  }

  /* Condition picker + matched product panels */
  .shop-picker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    max-width: 760px;
    margin: 0 auto 2.25rem;
  }
  .shop-picker__opt {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--cream);
    background: rgba(255, 244, 206, 0.06);
    border: 1px solid rgba(255, 244, 206, 0.25);
    padding: 0.65rem 1.3rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .shop-picker__opt:hover { border-color: var(--amber); }
  .shop-picker__opt.is-active {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--maroon);
  }
  .shop-panel[hidden] { display: none; }
  .shop-panel__empty {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }
  .shop-panel__empty p {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--cream);
    opacity: 0.85;
    line-height: 1.6;
    margin: 0 0 1.1rem;
  }
  .shop-panel__empty-cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--maroon);
    background: var(--amber);
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .shop-panel__empty-cta:hover { background: var(--amber-light); }

  /* On-page cart bar — appears once something is in the cart so both
     products can be added before heading to checkout (the primary cart
     entry point on mobile, where the header nav collapses). */
  .shop-cartbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem 1.25rem;
    flex-wrap: wrap;
    max-width: 760px;
    margin: 1.75rem auto 0;
    padding: 0.9rem 1.25rem;
    background: rgba(255, 244, 206, 0.06);
    border: 1px solid rgba(255, 244, 206, 0.18);
    border-radius: 14px;
  }
  .shop-cartbar[hidden] { display: none; }
  .shop-cartbar__count {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--cream);
    opacity: 0.85;
  }
  .shop-cartbar__link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--maroon);
    background: var(--amber);
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .shop-cartbar__link:hover { background: var(--amber-light); }

  /* Cross-sell band — catches visitors who clicked Shop but need a
     clinician, not a product. Sits between the maroon hero and the
     cream values strip. */
  .shop-treatment {
    background: var(--cream);
    color: var(--maroon);
    padding: 3.5rem 1.5rem 1.25rem;
  }
  .shop-treatment__inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }
  .shop-treatment__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--maroon);
    opacity: 0.55;
    margin: 0 0 0.85rem;
  }
  .shop-treatment__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 400;
    color: var(--maroon);
    line-height: 1.2;
    margin: 0 0 0.85rem;
  }
  .shop-treatment__desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--maroon);
    opacity: 0.78;
    line-height: 1.6;
    margin: 0 auto 1.6rem;
    max-width: 36rem;
  }
  .shop-treatment__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.6rem;
    background: var(--maroon);
    color: var(--cream);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .shop-treatment__cta:hover {
    background: var(--terracotta);
    transform: translateY(-2px);
  }
  .shop-treatment__cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.25s ease;
  }
  .shop-treatment__cta:hover svg { transform: translateX(3px); }

  /* Values strip - cream section, high contrast */
  .shop-values {
    background: var(--cream);
    color: var(--maroon);
    padding: 3.5rem 1.5rem;
  }
  .shop-values__grid {
    max-width: 360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .shop-values__item {
    text-align: center;
  }
  .shop-values__icon {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 0.75rem;
    border-radius: 14px;
    background: rgba(5, 90, 91, 0.1);
    color: #055A5B;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shop-values__title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--maroon);
    margin: 0 0 0.35rem 0;
  }
  .shop-values__desc {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--maroon);
    opacity: 0.7;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 640px) {
    .shop-hero { padding: 3rem 1.25rem; }
    .shop-hero__title { font-size: 2rem; }
    .shop-hero__featured { grid-template-columns: 1fr; gap: 2rem; }
    .shop-mockup__name-top { font-size: 3rem; }
    .shop-mockup__name-bottom { font-size: 2rem; }
    .shop-featured__name { font-size: 2rem; }
    .shop-featured__cta-wrap { display: block; }
    .shop-featured__btn { width: 100%; text-align: center; }
    .shop-values__grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>

<section class="shop-hero">
  <div class="shop-hero__watermark" aria-hidden="true"></div>
  <div class="shop-hero__inner">
    <div class="shop-hero__head fade-in">
      <p class="shop-hero__eyebrow">Kyn Select</p>
      <h1 class="shop-hero__title">Products we like that work with your treatment.</h1>
      <p class="shop-hero__subtitle">Pick what you're treating and see the over-the-counter products we pair with it.</p>
    </div>

    {%- comment -%} Condition-matched Kyn Select shelf. Each condition maps to a
       list of Shopify product handles via the parallel arrays below (edit in one
       place; outer separator ";" splits conditions, inner "," splits handles).
       Missing/unpublished handles are skipped. JS swaps the visible panel when a
       pill is tapped and honours ?condition=<key> for deep links from the nav or
       condition pages. {%- endcomment -%}
    {%- assign cond_keys = "fungal-acne,seb-derm-dandruff,tinea-versicolor" | split: "," -%}
    {%- assign cond_labels = "Fungal acne,Seb derm & dandruff,Tinea versicolor" | split: "," -%}
    {%- assign cond_links = "/pages/fungal-acne,/pages/seb-derm-dandruff,/pages/tinea-versicolor" | split: "," -%}
    {%- assign cond_handlesets = "coconut-oil-fractionated-mct;neutrogena-t-sal-scalp-build-up-control-therapeutic-shampoo-4-5-fl-oz,coconut-oil-fractionated-mct;neutrogena-t-sal-scalp-build-up-control-therapeutic-shampoo-4-5-fl-oz,coconut-oil-fractionated-mct" | split: ";" -%}

    <div class="shop-picker fade-in" role="tablist" aria-label="Choose what you're treating">
      {%- for key in cond_keys -%}
        <button type="button" class="shop-picker__opt{% if forloop.first %} is-active{% endif %}" data-cond="{{ key }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ cond_labels[forloop.index0] }}</button>
      {%- endfor -%}
    </div>

    <div class="shop-panels fade-in">
      {%- for key in cond_keys -%}
        {%- assign ci = forloop.index0 -%}
        {%- assign is_first = forloop.first -%}
        {%- assign chandles = cond_handlesets[ci] | split: "," -%}
        {%- assign valid = 0 -%}
        {%- for handle in chandles -%}{%- if all_products[handle] != blank -%}{%- assign valid = valid | plus: 1 -%}{%- endif -%}{%- endfor -%}
        <div class="shop-panel" data-cond="{{ key }}" role="tabpanel" aria-label="{{ cond_labels[ci] }} products"{% unless is_first %} hidden{% endunless %}>
          {%- if valid > 0 -%}
            <div class="shop-products">
              {%- for handle in chandles -%}
                {%- assign product = all_products[handle] -%}
                {%- if product != blank -%}
                  {%- assign variant = product.selected_or_first_available_variant -%}
                  <div class="shop-product-card">
                    {%- if product.featured_image != blank -%}
                      <a href="{{ product.url }}" class="shop-product-card__image">
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          width="600" height="600" loading="lazy">
                      </a>
                    {%- endif -%}
                    <div class="shop-product-card__body">
                      <h2 class="shop-product-card__name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
                      <p class="shop-product-card__price">{{ variant.price | money_without_trailing_zeros }}</p>
                      {%- if product.description != blank -%}
                        <p class="shop-product-card__desc">{{ product.description | strip_html | truncatewords: 20 }}</p>
                      {%- endif -%}
                      {%- if variant != blank and variant.available -%}
                        {%- comment -%} JS adds via /cart/add.js and stays on the page so
                           multiple products can go in one cart. No-JS falls back to a
                           normal POST, which lands on the /cart page. {%- endcomment -%}
                        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-add-form>
                          <input type="hidden" name="id" value="{{ variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="shop-product-card__btn" data-add-btn data-label="Add to cart">Add to cart</button>
                        </form>
                      {%- else -%}
                        <span class="shop-product-card__btn shop-product-card__btn--disabled">Sold out</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="shop-panel__empty">
              <p>No over-the-counter picks here yet. For {{ cond_labels[ci] | downcase }}, the fastest path is a treatment plan from a board-certified dermatologist.</p>
              <a href="{{ cond_links[ci] }}" class="shop-panel__empty-cta">Get {{ cond_labels[ci] | downcase }} care &rarr;</a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="shop-cartbar" id="shopCartBar"{% if cart.item_count == 0 %} hidden{% endif %}>
      <span class="shop-cartbar__count" data-shop-cart-summary>{{ cart.item_count }} item{% unless cart.item_count == 1 %}s{% endunless %} in your cart</span>
      <a href="{{ routes.cart_url }}" class="shop-cartbar__link">View cart &amp; check out &rarr;</a>
    </div>
  </div>
</section>

