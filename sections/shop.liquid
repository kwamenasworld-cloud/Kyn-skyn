<script>
  // Condition picker: swap the visible product panel; honour ?condition=<key>.
  (function () {
    var opts = document.querySelectorAll('.shop-picker__opt');
    var panels = document.querySelectorAll('.shop-panel');
    if (!opts.length || !panels.length) return;
    function select(cond) {
      Array.prototype.forEach.call(opts, function (o) {
        var on = o.getAttribute('data-cond') === cond;
        o.classList.toggle('is-active', on);
        o.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      Array.prototype.forEach.call(panels, function (p) {
        p.hidden = p.getAttribute('data-cond') !== cond;
      });
    }
    Array.prototype.forEach.call(opts, function (o) {
      o.addEventListener('click', function () { select(o.getAttribute('data-cond')); });
    });
    try {
      var q = new URLSearchParams(window.location.search).get('condition');
      if (q) {
        var found = Array.prototype.some.call(opts, function (o) { return o.getAttribute('data-cond') === q; });
        if (found) select(q);
      }
    } catch (e) {}
  })();

  (function () {
    var forms = document.querySelectorAll('[data-add-form]');
    if (!forms.length) return;
    var bar = document.getElementById('shopCartBar');
    var summary = document.querySelector('[data-shop-cart-summary]');
    var headerCount = document.querySelector('[data-cart-count]');

    function sync(cart) {
      var n = cart.item_count;
      var s = n === 1 ? '' : 's';
      if (summary) summary.textContent = n + ' item' + s + ' in your cart';
      if (bar) bar.hidden = n === 0;
      if (headerCount) {
        headerCount.textContent = n;
        if (n > 0) headerCount.removeAttribute('hidden');
        else headerCount.setAttribute('hidden', '');
      }
    }

    forms.forEach(function (form) {
      form.addEventListener('submit', function (e) {
        if (!window.fetch) return; // old browser: let the normal POST to /cart run
        e.preventDefault();
        var btn = form.querySelector('[data-add-btn]');
        var label = btn ? (btn.getAttribute('data-label') || btn.textContent) : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form)
        })
          .then(function (r) { if (!r.ok) throw new Error('add failed'); return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }); })
          .then(function (r) { return r.json(); })
          .then(function (cart) {
            sync(cart);
            if (btn) {
              btn.textContent = 'Added ✓';
              setTimeout(function () { btn.textContent = label; btn.disabled = false; }, 1500);
            }
          })
          .catch(function () {
            if (btn) { btn.textContent = label; btn.disabled = false; }
            form.submit(); // fall back to a normal add + redirect to /cart
          });
      });
    });
  })();
</script>

