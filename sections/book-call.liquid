{%- comment -%}
  Book-a-call page. A free 1:1 booking page that embeds Calendly so a visitor
  can schedule time with a Kyn specialist (a member of the Kyn team, NOT a
  clinician). Kept deliberately separate from sections/consultation.liquid,
  which is the clinical Kynsultation / dermatologist checkout flow. This page
  is sales / guidance only and must never imply diagnosis or prescription.
  Stripped to just the scheduler: heading + Calendly box.

  The box uses a tall fixed height (set in CSS, responsive) rather than
  Calendly's data-resize auto-fit: data-resize collapsed the box to ~0 height
  in testing because its calendly.page_height message can report a tiny value
  with no floor to catch it. A generous fixed height renders reliably and
  fits the scheduler without inner scroll in the normal flow. The
  preconnect/preload hints warm the Calendly connection so it paints faster.
  Inline style + the Calendly external widget only.
{%- endcomment -%}

<link rel="preconnect" href="https://assets.calendly.com">
<link rel="preconnect" href="https://assets.calendly.com" crossorigin>
<link rel="preconnect" href="https://calendly.com">
<link rel="preload" as="script" href="https://assets.calendly.com/assets/external/widget.js">

<section class="bc-calendar" id="bc-calendar">
  <div class="bc-calendar__container">
    <p class="bc-calendar__eyebrow fade-in">Free 1:1 call</p>
    <h1 class="bc-calendar__heading fade-in">Pick a time</h1>
    <p class="bc-calendar__copy fade-in">Book a free 15-minute call with a Kyn specialist.</p>

    <!-- Calendly inline widget. Tall fixed height set in CSS (see
         .bc-calendar__widget); brand colors passed via query params. -->
    <div
      id="bc-cal"
      class="calendly-inline-widget bc-calendar__widget fade-in"
      data-url="https://calendly.com/john-kynskyn/new-meeting?hide_gdpr_banner=1&background_color=fff4ce&text_color=641220&primary_color=c75b2a"
      style="min-width:320px;"></div>
    <script>
      /* Forward the visitor's UTM params onto the Calendly scheduling URL so each
         booking is attributable to its ad/campaign. Runs synchronously here,
         BEFORE the async widget.js below initializes the embed, so auto-init
         reads the augmented data-url. Calendly natively captures utm_* params. */
      (function () {
        try {
          var el = document.getElementById("bc-cal");
          if (!el) return;
          var p = new URLSearchParams(location.search);
          var extra = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"]
            .filter(function (k) { return p.get(k); })
            .map(function (k) { return encodeURIComponent(k) + "=" + encodeURIComponent(p.get(k)); })
            .join("&");
          if (extra) el.setAttribute("data-url", el.getAttribute("data-url") + "&" + extra);
        } catch (e) {}
      })();
    </script>
    <noscript>
      <p class="bc-calendar__note">
        Enable JavaScript to load the scheduler, or
        <a href="https://calendly.com/john-kynskyn/new-meeting" target="_blank" rel="noopener">book your call here</a>.
      </p>
    </noscript>

    <p class="bc-calendar__note fade-in">Your specialist is a member of the Kyn team, not a clinician. For a diagnosis or prescription, book a <a href="/pages/consultation?checkout=1">Kynsultation</a>.</p>
  </div>
</section>

<style>
  .bc-calendar {
    padding: 7rem 1.5rem 4rem;
    background: var(--dark);
  }
  .bc-calendar__container {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
  }
  .bc-calendar__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.5;
    margin-bottom: 1.25rem;
  }
  .bc-calendar__heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 300;
    color: var(--cream);
    margin: 0 0 0.75rem;
  }
  .bc-calendar__copy {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--cream);
    opacity: 0.62;
    line-height: 1.6;
    max-width: 32rem;
    margin: 0 auto 2.25rem;
  }
  .bc-calendar__widget {
    /* Tall fixed height so the scheduler fits without scrolling inside the
       box. Calendly content taller than this scrolls internally (rare on
       desktop); the page scrolls otherwise. */
    height: 1000px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 24px 70px -46px rgba(0, 0, 0, 0.8);
    position: relative;
  }
  /* Lightweight spinner shown until Calendly's iframe paints over it. */
  .bc-calendar__widget::before {
    content: "";
    position: absolute;
    top: 130px;
    left: 50%;
    width: 32px;
    height: 32px;
    margin-left: -16px;
    border: 3px solid rgba(100, 18, 32, 0.18);
    border-top-color: var(--maroon);
    border-radius: 50%;
    animation: bc-spin 0.8s linear infinite;
    z-index: 0;
  }
  @keyframes bc-spin { to { transform: rotate(360deg); } }
  .bc-calendar__note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--cream);
    opacity: 0.45;
    line-height: 1.6;
    max-width: 34rem;
    margin: 1.5rem auto 0;
  }
  .bc-calendar__note a { color: var(--gold); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 768px) {
    .bc-calendar { padding: 6rem 1.25rem 3rem; }
    /* Single-column Calendly layout is taller on mobile. */
    .bc-calendar__widget { height: 1180px; }
  }
</style>

<script src="https://assets.calendly.com/assets/external/widget.js" async></script>

<script>
  /* Booking conversion tracking. Calendly posts a window message when an event
     is scheduled; on that, fire a Meta Pixel Schedule event (browser) and a
     first-party `call_booked` funnel beacon (same session + attribution +
     country as the pageview). Without this, completed bookings are invisible to
     Meta and to the funnel. */
  (function () {
    window.addEventListener("message", function (e) {
      if (e.origin !== "https://calendly.com") return;
      if (!e.data || e.data.event !== "calendly.event_scheduled") return;
      try { if (window.fbq) fbq("track", "Schedule", { content_name: "book_a_call" }); } catch (err) {}
      try { if (window.KynFunnel) window.KynFunnel.send("call_booked"); } catch (err) {}
    });
  })();
</script>

{% schema %}
{
  "name": "Book a Call",
  "class": "book-call-section"
}
{% endschema %}
