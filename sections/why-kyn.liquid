{% comment %}
  Why Kyn Care: a dedicated comparison + ongoing-care page.
  Built as its own page (not bolted onto an existing section) so the homepage
  stays focused. Renders via templates/page.why-kyn.json on a Shopify Page
  whose template is "page.why-kyn".

  The "What patients say" block renders ONLY when testimonial blocks exist.
  Add real testimonials through the theme editor (or the template JSON) once
  you have them. With no blocks, the whole proof section is omitted, so the
  page never ships placeholder or invented reviews.
{% endcomment %}

<style>
  .why-kyn-section .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ========== WHY HERO ========== */
  .why-hero {
    background: var(--dark);
    padding: 10rem 3rem 5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .why-hero__molecule {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40rem;
    height: 40rem;
    opacity: 0.04;
    pointer-events: none;
  }
  .why-hero__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.5;
    margin-bottom: 1.5rem;
  }
  .why-hero__heading {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 300;
    color: var(--cream);
    line-height: 1.15;
    max-width: 46rem;
    margin: 0 auto 1.5rem;
  }
  .why-hero__desc {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--cream);
    opacity: 0.62;
    line-height: 1.7;
    max-width: 38rem;
    margin: 0 auto 2.5rem;
  }
  .why-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--button);
    padding: 1rem 2.5rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.3s;
  }
  .why-hero__cta:hover { background: var(--maroon); }
  .why-hero__cta svg { width: 18px; height: 18px; }

  /* ========== COMPARISON ========== */
  .why-compare {
    background: var(--cream);
    padding: 6rem 3rem;
  }
  .why-compare__container { max-width: 64rem; margin: 0 auto; }
  .why-compare__head { text-align: center; margin-bottom: 3rem; }
  .why-compare__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--maroon);
    opacity: 0.5;
    margin-bottom: 1rem;
  }
  .why-compare__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 300;
    color: var(--maroon);
    margin: 0;
  }
  .why-compare__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .why-table {
    width: 100%;
    min-width: 40rem;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--font-sans);
  }
  .why-table th,
  .why-table td {
    padding: 0.95rem 1.05rem;
    text-align: left;
    vertical-align: top;
    font-size: 0.85rem;
    line-height: 1.45;
    border-bottom: 1px solid rgba(100, 18, 32, 0.12);
  }
  .why-table thead th {
    font-family: var(--font-accent);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--maroon);
    font-weight: 600;
    border-bottom: 2px solid rgba(100, 18, 32, 0.25);
  }
  .why-table tbody th {
    font-weight: 600;
    color: var(--maroon);
    width: 12rem;
  }
  .why-table td { color: rgba(61, 32, 37, 0.78); }
  /* Highlighted Kyn Care column */
  .why-table th.is-kyn,
  .why-table td.is-kyn {
    background: rgba(248, 176, 68, 0.14);
    color: var(--maroon);
    font-weight: 600;
  }
  .why-table thead th.is-kyn {
    color: var(--maroon);
    border-bottom-color: var(--gold);
  }
  .why-table tbody tr:last-child td,
  .why-table tbody tr:last-child th { border-bottom: 0; }
  .why-table__corner-kyn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .why-table__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--terracotta);
    flex-shrink: 0;
  }

  /* ========== ONGOING CARE ========== */
  .why-care {
    background: var(--dark);
    padding: 6rem 3rem;
  }
  .why-care__container { max-width: 64rem; margin: 0 auto; }
  .why-care__head { text-align: center; margin-bottom: 3rem; }
  .why-care__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.5;
    margin-bottom: 1rem;
  }
  .why-care__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 300;
    color: var(--cream);
    margin: 0;
  }
  .why-care__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .why-care__card {
    background: rgba(255, 244, 206, 0.04);
    border: 1px solid rgba(255, 244, 206, 0.14);
    border-radius: 1.25rem;
    padding: 1.6rem 1.5rem;
  }
  .why-care__icon { display: inline-block; width: 28px; height: 28px; color: var(--gold); margin-bottom: 1rem; }
  .why-care__icon svg { width: 100%; height: 100%; }
  .why-care__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--cream);
    margin: 0 0 0.45rem;
  }
  .why-care__text {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--cream);
    opacity: 0.66;
    margin: 0;
  }

  /* ========== GUARANTEE ========== */
  .why-promise {
    background: var(--cream);
    padding: 4.5rem 3rem;
    text-align: center;
  }
  .why-promise__inner {
    max-width: 40rem;
    margin: 0 auto;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 600;
    color: var(--maroon);
    padding: 1.4rem 1.6rem;
    border: 1px solid rgba(199, 91, 42, 0.4);
    border-radius: 14px;
    background: rgba(212, 149, 42, 0.08);
  }

  /* ========== TESTIMONIALS ========== */
  .why-proof {
    background: var(--dark);
    padding: 6rem 3rem;
  }
  .why-proof__container { max-width: 60rem; margin: 0 auto; text-align: center; }
  .why-proof__eyebrow {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.5;
    margin-bottom: 1rem;
  }
  .why-proof__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 300;
    color: var(--cream);
    margin: 0 0 3rem;
  }
  .why-proof__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    text-align: left;
  }
  .why-quote {
    background: rgba(255, 244, 206, 0.04);
    border: 1px solid rgba(255, 244, 206, 0.14);
    border-radius: 1.25rem;
    padding: 1.6rem 1.5rem;
  }
  .why-quote__text {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--cream);
    margin: 0 0 1rem;
  }
  .why-quote__attr {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--cream);
    opacity: 0.6;
  }
  .why-quote__name { font-weight: 600; opacity: 0.85; }

  /* ========== FINAL CTA ========== */
  .why-final {
    background: var(--maroon);
    padding: 6rem 3rem;
    text-align: center;
  }
  .why-final__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 300;
    color: var(--cream);
    margin: 0 0 2rem;
  }
  .why-final__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--cream);
    color: var(--maroon);
    font-family: var(--font-accent);
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1.1rem 2.2rem;
    border-radius: 999px;
    box-shadow: 0 10px 30px -10px rgba(42, 2, 8, 0.55);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .why-final__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px -12px rgba(42, 2, 8, 0.7);
  }
  .why-final__cta svg { width: 18px; height: 18px; flex-shrink: 0; }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 768px) {
    .why-hero { padding: 8rem 1.5rem 3rem; }
    .why-compare { padding: 4rem 1.5rem; }
    .why-care { padding: 4rem 1.5rem; }
    .why-care__grid { grid-template-columns: 1fr; }
    .why-promise { padding: 3.5rem 1.5rem; }
    .why-proof { padding: 4rem 1.5rem; }
    .why-proof__grid { grid-template-columns: 1fr; }
    .why-final { padding: 4rem 1.5rem; }
  }
</style>

<!-- ====== HERO ====== -->
<section class="why-hero">
  <img src="{{ 'molecule.svg' | asset_url }}" alt="" aria-hidden="true" class="why-hero__molecule" width="667" height="667">
  <p class="why-hero__eyebrow fade-in">Why Kyn Care</p>
  <h1 class="why-hero__heading fade-in">Care built for chronic skin, start to finish.</h1>
  <p class="why-hero__desc fade-in">Most skin care is built for everything in general. Kyn Care is built for chronic skin conditions, the kind that flare, settle, and come back. A board-certified dermatologist diagnoses what is actually going on, including concerns like fungal acne, seborrheic dermatitis, dandruff, and tinea versicolor, then stays with you as your skin changes.</p>
  <a href="/pages/consultation?checkout=1" class="why-hero__cta fade-in" aria-label="Start your visit with a board-certified dermatologist">
    Start your visit
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</section>

<!-- ====== COMPARISON ====== -->
<section class="why-compare">
  <div class="why-compare__container">
    <div class="why-compare__head fade-in">
      <p class="why-compare__eyebrow">The options</p>
      <h2 class="why-compare__heading">How Kyn Care compares</h2>
    </div>
    <div class="why-compare__scroll fade-in">
      <table class="why-table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col">In-person dermatology</th>
            <th scope="col">One-and-done online Rx</th>
            <th scope="col" class="is-kyn">
              <span class="why-table__corner-kyn"><span class="why-table__dot" aria-hidden="true"></span>Kyn Care</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Wait to be seen</th>
            <td>Often weeks to months</td>
            <td>Often same day</td>
            <td class="is-kyn">Usually reviewed within 48 hours</td>
          </tr>
          <tr>
            <th scope="row">What it costs</th>
            <td>$150 to $300 per visit</td>
            <td>Low upfront, varies</td>
            <td class="is-kyn">$29.99 a month, or $59 one-time</td>
          </tr>
          <tr>
            <th scope="row">Who reviews your case</th>
            <td>A dermatologist, if you can book one</td>
            <td>Not always a dermatologist</td>
            <td class="is-kyn">A board-certified dermatologist</td>
          </tr>
          <tr>
            <th scope="row">Follow-ups and adjustments</th>
            <td>A new appointment each time</td>
            <td>None after the prescription</td>
            <td class="is-kyn">Included with your membership</td>
          </tr>
          <tr>
            <th scope="row">Messaging between visits</th>
            <td>Limited</td>
            <td>None</td>
            <td class="is-kyn">Yes, with your dermatologist while your plan is active</td>
          </tr>
          <tr>
            <th scope="row">Check-ins over time</th>
            <td>Not typical</td>
            <td>None</td>
            <td class="is-kyn">Monthly, included</td>
          </tr>
          <tr>
            <th scope="row">Prescriptions</th>
            <td>Yes</td>
            <td>Yes</td>
            <td class="is-kyn">Sent to the pharmacy you choose, when appropriate</td>
          </tr>
          <tr>
            <th scope="row">Where you are treated</th>
            <td>In office</td>
            <td>Online</td>
            <td class="is-kyn">Online, from anywhere in the US</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ====== ONGOING CARE ====== -->
<section class="why-care">
  <div class="why-care__container">
    <div class="why-care__head fade-in">
      <p class="why-care__eyebrow">Ongoing care</p>
      <h2 class="why-care__heading">Care that keeps going</h2>
    </div>
    <div class="why-care__grid">
      <div class="why-care__card fade-in">
        <span class="why-care__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <h3 class="why-care__title">A dermatologist reviews your case</h3>
        <p class="why-care__text">Every visit is read by a board-certified dermatologist who confirms the diagnosis and builds your plan. Not a chatbot, not a generalist.</p>
      </div>
      <div class="why-care__card fade-in">
        <span class="why-care__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </span>
        <h3 class="why-care__title">Message while your plan is active</h3>
        <p class="why-care__text">Ask follow-up questions in the same thread. Replies usually come within 24 to 48 hours.</p>
      </div>
      <div class="why-care__card fade-in">
        <span class="why-care__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </span>
        <h3 class="why-care__title">A check-in once a month</h3>
        <p class="why-care__text">Kyn Care checks in monthly so your plan stays right for your skin, without turning care into homework.</p>
      </div>
      <div class="why-care__card fade-in">
        <span class="why-care__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </span>
        <h3 class="why-care__title">Track your progress</h3>
        <p class="why-care__text">Add a monthly progress photo so changes are easy to see over time and your dermatologist can adjust as your skin responds.</p>
      </div>
    </div>
  </div>
</section>

<!-- ====== GUARANTEE ====== -->
<section class="why-promise">
  <p class="why-promise__inner fade-in">Our promise: if a board-certified dermatologist reviews your visit and can&rsquo;t give you a diagnosis and a treatment plan, we&rsquo;ll refund it.</p>
</section>

{% comment %} Testimonials render only when blocks are present. {% endcomment %}
{% if section.blocks.size > 0 %}
<!-- ====== TESTIMONIALS ====== -->
<section class="why-proof">
  <div class="why-proof__container">
    <p class="why-proof__eyebrow fade-in">Patients</p>
    <h2 class="why-proof__heading fade-in">What patients say</h2>
    <div class="why-proof__grid">
      {% for block in section.blocks %}
        {% if block.type == 'testimonial' and block.settings.quote != blank %}
          <figure class="why-quote fade-in" {{ block.shopify_attributes }}>
            <blockquote class="why-quote__text">{{ block.settings.quote }}</blockquote>
            <figcaption class="why-quote__attr">
              {% if block.settings.name != blank %}<span class="why-quote__name">{{ block.settings.name }}</span>{% endif %}
              {% if block.settings.detail != blank %} &middot; {{ block.settings.detail }}{% endif %}
            </figcaption>
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ====== FINAL CTA ====== -->
<section class="why-final">
  <h2 class="why-final__heading fade-in">Start with a board-certified dermatologist.</h2>
  <a href="/pages/consultation?checkout=1" class="why-final__cta fade-in" aria-label="Start your visit with a board-certified dermatologist">
    Start your visit
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m0 0l-4-4m4 4l-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>
</section>

{% schema %}
{
  "name": "Why Kyn Care",
  "class": "why-kyn-section",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Use a real patient quote with consent. Leave all blocks off to hide the testimonials section." },
        { "type": "text", "id": "name", "label": "Name", "info": "First name and last initial, e.g. Maya R." },
        { "type": "text", "id": "detail", "label": "Detail", "info": "Condition and time on plan, e.g. Fungal acne, 3 months" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Why Kyn Care" }]
}
{% endschema %}
