<!-- ====== CARE STEPS ====== -->
<style>
  .care-steps {
    position: relative;
    overflow: hidden;
    background-color: var(--gold);
    background-image:
      linear-gradient(rgba(255, 244, 206, 0.34) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 244, 206, 0.34) 1px, transparent 1px);
    background-size: 22px 22px;
    padding: clamp(4.5rem, 8vw, 7rem) 3rem 0;
    color: var(--dark);
  }
  .care-steps__container {
    max-width: 74rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(18rem, 0.9fr) minmax(22rem, 1.1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: end;
  }
  .care-steps__phone-wrap {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 34rem;
  }
  .care-phone {
    position: relative;
    width: min(24rem, 100%);
    aspect-ratio: 9 / 16;
    padding: 0.72rem;
    border-radius: 3rem 3rem 0 0;
    background: #0c0507;
    box-shadow: 0 2.2rem 4rem rgba(42, 2, 8, 0.28);
  }
  .care-phone::before {
    content: "";
    position: absolute;
    top: 0.72rem;
    left: 50%;
    z-index: 3;
    width: 7.4rem;
    height: 1.6rem;
    border-radius: 0 0 1rem 1rem;
    background: #0c0507;
    transform: translateX(-50%);
  }
  .care-phone__screen {
    height: 100%;
    border-radius: 2.35rem 2.35rem 0 0;
    background: #fffaf0;
    padding: 3.15rem 1.35rem 1.35rem;
    overflow: hidden;
  }
  .care-phone__brand {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3vw, 2.45rem);
    line-height: 1;
    color: var(--maroon);
    margin: 0 0 1.5rem;
  }
  .care-phone__nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }
  .care-phone__nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-sans);
    font-size: 0.52rem;
    color: rgba(100, 18, 32, 0.45);
  }
  .care-phone__nav-item::before {
    content: "";
    width: 1.05rem;
    height: 1.05rem;
    border: 1.5px solid currentColor;
    border-radius: 0.28rem;
  }
  .care-phone__nav-item.is-active {
    color: var(--maroon);
    font-weight: 600;
  }
  .care-phone__nav-item.is-active::before {
    border-radius: 999px;
    background: var(--gold);
    box-shadow: inset 0 0 0 0.3rem #fffaf0;
  }
  .care-phone__message {
    border-radius: 0.9rem;
    padding: 1rem 1.05rem;
    font-family: var(--font-sans);
    font-size: clamp(0.78rem, 1.2vw, 0.92rem);
    line-height: 1.42;
    color: var(--dark);
  }
  .care-phone__message--provider {
    width: 92%;
    background: rgba(212, 149, 42, 0.28);
    border: 1px solid rgba(100, 18, 32, 0.08);
    box-shadow: 0 0.6rem 1.8rem rgba(42, 2, 8, 0.08);
  }
  .care-phone__message--patient {
    width: 82%;
    margin: 1rem 0 0 auto;
    background: rgba(100, 18, 32, 0.08);
  }
  .care-phone__status {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon);
  }
  .care-phone__status::before {
    content: "";
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 999px;
    background: var(--terracotta);
  }
  .care-steps__content {
    align-self: center;
    padding: 1rem 0 clamp(4.5rem, 7vw, 6rem);
  }
  .care-steps__rule {
    width: 100%;
    height: 2px;
    background: var(--dark);
    opacity: 0.92;
    margin-bottom: 1.3rem;
  }
  .care-steps__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--maroon);
    margin: 0 0 0.7rem;
  }
  .care-steps__heading {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4.2vw, 3.15rem);
    font-weight: 700;
    color: var(--dark);
    line-height: 1.1;
    margin: 0 0 2.3rem;
  }
  .care-steps__list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.45rem, 2.8vw, 2.05rem);
  }
  .care-step {
