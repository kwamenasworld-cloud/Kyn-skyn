  <div class="notify__container fade-in">
    <p class="notify__eyebrow">Kyn Skyn updates</p>
    <h2 class="notify__heading">Clinical skin care, explained clearly.</h2>
    <p class="notify__desc">Get Malassezia-safe skincare and treatment updates.</p>

    <form class="notify__form" id="homeNotifyForm" action="javascript:void(0)" method="post" novalidate>
      <input class="notify__input" type="email" name="EMAIL" placeholder="Email address" required aria-label="Email address">
      <button class="notify__button" type="submit">Sign Up</button>
    </form>
    <p id="homeNotifyNote" aria-live="polite" style="display:none; color: var(--cream); opacity: 0.8; font-family: var(--font-sans); font-size: 0.9rem; margin-top: 1rem;"></p>

    <img src="{{ 'logomark-white.svg' | asset_url }}" alt="Kyn Skyn logomark" width="338" height="317" style="width: 4rem; height: auto; opacity: 0.15; margin-top: 3rem;">
  </div>
</section>

<script>
  (function() {
    var form = document.getElementById('homeNotifyForm');
    if (!form) return;
    var btn = form.querySelector('.notify__button');
    var input = form.querySelector('.notify__input');
    var note = document.getElementById('homeNotifyNote');

    function setNote(message, isError) {
      note.textContent = message;
      note.style.display = 'block';
      note.style.color = isError ? '#e8725a' : 'var(--cream)';
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      if (!input.checkValidity()) {
        setNote('Enter a valid email address.', true);
        input.focus();
        return;
      }

      note.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        await window.KynNewsletter.submit({
          email: email,
          source: 'home-newsletter'
        });

        btn.textContent = 'You\'re in!';
        btn.style.background = '#2a6e3f';
        input.value = '';
        setNote("You're on the list. We'll be in touch.", false);
        setTimeout(function() {
          btn.textContent = 'Sign Up';
          btn.style.background = '';
          btn.disabled = false;
        }, 4000);
      } catch (err) {
        btn.textContent = 'Sign Up';
        btn.style.background = '';
        btn.disabled = false;
        setNote(err && err.message ? err.message : 'That did not go through. Please try again.', true);
      }
    });
  })();
</script>

