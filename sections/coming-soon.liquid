<script>
  (function() {
    var form = document.getElementById('homeNotifyForm');
    if (!form) return;
    var btn = form.querySelector('.notify__button');
    var input = form.querySelector('.notify__input');
    var note = document.getElementById('homeNotifyNote');

    function setNote(message, isError) {
      note.textContent = message;
      note.style.display = 'block';
      note.style.color = isError ? '#e8725a' : 'var(--cream)';
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      var email = (input.value || '').trim();
      if (!input.checkValidity()) {
        setNote('Enter a valid email address.', true);
        input.focus();
        return;
      }

      note.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Sending...';

      try {
        await window.KynNewsletter.submit({
          email: email,
          source: 'home-newsletter'
        });

        btn.textContent = 'You\'re in!';
        btn.style.background = '#2a6e3f';
        input.value = '';
        setNote("You're on the list. We'll be in touch.", false);
        setTimeout(function() {
          btn.textContent = 'Sign Up';
          btn.style.background = '';
          btn.disabled = false;
        }, 4000);
      } catch (err) {
        btn.textContent = 'Sign Up';
        btn.style.background = '';
        btn.disabled = false;
        setNote(err && err.message ? err.message : 'That did not go through. Please try again.', true);
      }
    });
  })();
</script>

