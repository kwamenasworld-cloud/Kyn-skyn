<!-- ====== CONDITIONS ====== -->
<style>
  .conditions {
    background: var(--cream);
    padding: 6rem 3rem;
  }

  .conditions__container {
    max-width: 60rem;
    margin: 0 auto;
  }

  .conditions__head {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .conditions__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--maroon);
    opacity: 0.6;
    margin: 0 0 1rem;
  }

  .conditions__heading {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--maroon);
    line-height: 1.1;
    margin: 0;
  }

  .conditions__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .cond-card {
    display: flex;
    flex-direction: column;
    border-radius: 1.5rem;
    overflow: hidden;
    text-decoration: none;
    color: var(--maroon);
    background: var(--cream);
    box-shadow: 0 1px 2px rgba(42, 2, 8, 0.04), 0 8px 24px -10px rgba(42, 2, 8, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cond-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 1px 2px rgba(42, 2, 8, 0.06), 0 18px 40px -12px rgba(42, 2, 8, 0.22);
  }

  .cond-card__top {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }

  .cond-card__top img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cond-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.2rem 1rem 1.3rem;
    background: var(--cream);
    border-top: 1px solid rgba(100, 18, 32, 0.08);
  }

  .cond-card__label {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    font-weight: 400;
    color: var(--maroon);
    line-height: 1.1;
  }

  .cond-card__arrow {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--maroon);
    color: var(--cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.25s ease;
    flex-shrink: 0;
  }

  .cond-card:hover .cond-card__arrow {
    background: var(--terracotta);
    transform: translateX(4px);
  }

  .cond-card__arrow svg { width: 1rem; height: 1rem; }

  @media (max-width: 900px) {
    .conditions { padding: 4rem 1.5rem; }
    .conditions__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

