<!-- ====== CARE GRID ====== -->
<style>
  .care-grid {
    background: var(--dark);
    padding: 6rem 3rem;
  }
  .care-grid__container { max-width: 64rem; margin: 0 auto; }
  .care-grid__head { text-align: center; margin-bottom: 3rem; }
  .care-grid__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    color: var(--cream);
    line-height: 1.1;
    margin: 0;
  }
  .care-grid__bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, minmax(168px, 1fr));
    grid-template-areas:
      "matched messaging rx anywhere"
      "matched video     rx anywhere";
    gap: 1rem;
  }
  .care-tile {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
  }
  .care-tile__icon { width: 30px; height: 30px; margin-bottom: auto; }
  .care-tile__icon svg { width: 100%; height: 100%; }
  .care-tile__title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.15;
    margin: 0.85rem 0 0.35rem;
  }
  .care-tile__text {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.45;
    opacity: 0.88;
    margin: 0;
  }
  .care-tile--matched   { grid-area: matched;   background: var(--maroon);     color: var(--cream); }
  .care-tile--messaging { grid-area: messaging; background: var(--terracotta); color: var(--cream); }
  .care-tile--video     { grid-area: video;     background: #3d0810;           color: var(--cream); border: 1px solid rgba(255, 244, 206, 0.14); }
  .care-tile--rx        { grid-area: rx;         color: var(--cream); }
  .care-tile--anywhere  { grid-area: anywhere;  background: var(--gold);       color: var(--dark); }
  .care-tile__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .care-tile::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .care-tile--matched::after {
    background: linear-gradient(to top, rgba(42, 2, 8, 0.72) 0%, rgba(42, 2, 8, 0.26) 58%, rgba(42, 2, 8, 0.04) 100%);
  }
  .care-tile--messaging::after,
  .care-tile--video::after,
  .care-tile--rx::after {
    background: linear-gradient(to top, rgba(42, 2, 8, 0.94) 0%, rgba(42, 2, 8, 0.4) 55%, rgba(42, 2, 8, 0.12) 100%);
  }
  .care-tile--anywhere::after {
    background: linear-gradient(to top, rgba(212, 149, 42, 0.84) 0%, rgba(212, 149, 42, 0.38) 58%, rgba(212, 149, 42, 0.03) 100%);
  }
  .care-tile > *:not(.care-tile__media) { position: relative; z-index: 2; }
  .care-tile__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.85rem; }
  .care-tile__chip {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    background: rgba(42, 2, 8, 0.16);
    color: var(--dark);
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
  }
  @media (max-width: 900px) {
    .care-grid { padding: 4rem 1.5rem; }
    .care-grid__bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
      grid-template-areas: none;
    }
    .care-tile { grid-area: auto; min-height: 170px; }
    .care-tile--matched, .care-tile--rx, .care-tile--anywhere { grid-column: 1 / -1; min-height: 200px; }
  }
  @media (max-width: 560px) {
    .care-grid__bento { grid-template-columns: 1fr; }
    .care-tile--matched, .care-tile--rx, .care-tile--anywhere { grid-column: auto; }
  }
</style>

