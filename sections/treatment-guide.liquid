{%- liquid
  assign is_roflumilast = false
  assign is_ketoconazole = false
  if page.handle == 'roflumilast'
    assign is_roflumilast = true
    assign treatment_name = 'Roflumilast'
    assign treatment_label = 'Medication guide'
    assign hero_heading = 'Roflumilast in seborrheic dermatitis care'
    assign hero_sub = 'Roflumilast is a prescription topical PDE4 inhibitor used for inflammatory skin conditions. This guide explains when it may enter a clinician-led seborrheic dermatitis plan. Kyn Skyn does not sell or ship roflumilast, Zoryve, or any specific medication.'
    assign primary_condition_url = '/pages/seb-derm-dandruff'
    assign primary_condition_label = 'Seb derm and dandruff guide'
    assign reviewed_date = 'May 21, 2026'
  elsif page.handle == 'ketoconazole'
    assign is_ketoconazole = true
    assign treatment_name = 'Ketoconazole'
    assign treatment_label = 'Medication guide'
    assign hero_heading = 'Ketoconazole in fungal acne, seb derm, dandruff, and tinea versicolor care'
    assign hero_sub = 'Ketoconazole is an antifungal medicine used in topical formats such as cream, shampoo, and foam. This guide explains how it may fit into clinician-led care for Malassezia-driven skin problems. Kyn Skyn does not sell or ship ketoconazole or any specific medication.'
    assign primary_condition_url = '/pages/fungal-acne'
    assign primary_condition_label = 'Fungal acne guide'
    assign reviewed_date = 'May 21, 2026'
  endif
-%}

{%- if is_roflumilast or is_ketoconazole -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": {{ page.title | default: hero_heading | json }},
  "headline": {{ hero_heading | json }},
  "description": {{ hero_sub | strip_html | json }},
  "url": {{ canonical_url | json }},
  "inLanguage": "en-US",
  "dateModified": "2026-05-21",
  "lastReviewed": "2026-05-21",
  "publisher": {
    "@type": "Organization",
    "name": "Kyn Skyn",
    "url": "https://kynskyn.com",
    "logo": "https:{{ 'logomark.svg' | asset_url }}"
  },
  "about": {
    "@type": "Drug",
    "name": {{ treatment_name | json }},
    "prescribingInfo": {%- if is_roflumilast -%}"https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=f9e0b4a9-a227-4947-b00c-41fb18d16589"{%- else -%}"https://medlineplus.gov/druginfo/meds/a605014.html"{%- endif -%}
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- if is_roflumilast -%}
    {
      "@type": "Question",
      "name": "Is rolfimulast the same as roflumilast?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Usually, yes. Rolfimulast is a common misspelling. The correct medicine name is roflumilast, and Zoryve is a brand name for topical roflumilast."
      }
    },
    {
      "@type": "Question",
      "name": "Is roflumilast an antifungal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Roflumilast is a PDE4 inhibitor used to reduce inflammation. For seborrheic dermatitis, a clinician may also consider antifungal treatment depending on the diagnosis and flare pattern."
      }
    },
    {
      "@type": "Question",
      "name": "Does Kyn Skyn sell roflumilast?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Kyn Skyn provides clinician-led dermatology care and treatment plans. If a prescription is clinically appropriate, it is sent to your chosen pharmacy. We do not sell, ship, or guarantee roflumilast or any specific medication."
      }
    }
    {%- else -%}
    {
      "@type": "Question",
      "name": "Is ketoconazole used for fungal acne?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ketoconazole targets fungus and yeast. A clinician may consider it when symptoms and photos fit a Malassezia-driven condition, but fungal acne needs a proper diagnosis because regular acne can look similar."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between ketoconazole 1% and 2%?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In the United States, some ketoconazole 1% shampoos are available over the counter, while many 2% formats are prescription products. The right format depends on the body area and diagnosis."
      }
    },
    {
      "@type": "Question",
      "name": "Does Kyn Skyn sell ketoconazole?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Kyn Skyn provides clinician-led dermatology care and treatment plans. If a prescription is clinically appropriate, it is sent to your chosen pharmacy. We do not sell, ship, or guarantee ketoconazole or any specific medication."
      }
    }
    {%- endif -%}
  ]
}
</script>

