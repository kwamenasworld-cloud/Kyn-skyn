      transition: background 0.3s;
      white-space: nowrap;
    }

    .notify__button:hover { background: var(--maroon); }

    .notify__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--cream);
      color: var(--maroon);
      font-family: var(--font-accent);
      font-size: 0.95rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 1.1rem 2.2rem;
      border-radius: 999px;
      box-shadow: 0 10px 30px -10px rgba(42, 2, 8, 0.55);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .notify__cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(42, 2, 8, 0.7);
    }

    .notify__cta svg { width: 18px; height: 18px; flex-shrink: 0; }

    .notify__newsletter { margin-top: 3.5rem; }

    .notify__newsletter-label {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--cream);
      opacity: 0.5;
      margin-bottom: 1rem;
