    .contact__submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .contact__confirmation {
      display: none;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      color: var(--maroon);
      opacity: 0.8;
      margin-top: 1rem;
    }

    /* ========== FOOTER ========== */
    .site-footer {
      background: var(--dark);
      padding: 5rem 3rem 2.5rem;
      border-top: 1px solid rgba(255, 244, 206, 0.06);
    }

    .footer__container { max-width: 72rem; margin: 0 auto; }

    .footer__top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 3rem;
      border-bottom: 1px solid rgba(255, 244, 206, 0.1);
    }

    .footer__logo svg { height: 24px; color: var(--cream); fill: var(--cream); }

    .footer__nav { display: flex; gap: 2rem; list-style: none; }

    .footer__nav a {
      color: var(--cream);
      text-decoration: none;
      font-family: var(--font-sans);
      font-size: 0.8rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.6;
      transition: opacity 0.3s;
    }

    .footer__nav a:hover { opacity: 1; }

    .footer__social { display: flex; gap: 1.2rem; }
    .footer__social a { color: var(--cream); opacity: 0.5; transition: opacity 0.3s; }
    .footer__social a:hover { opacity: 1; }
    .footer__social svg { width: 18px; height: 18px; }

    .footer__bottom {
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer__copy {
      font-family: var(--font-sans);
      font-size: 0.7rem;
      color: var(--cream);
      opacity: 0.3;
      letter-spacing: 0.04em;
    }

    /* ========== MOBILE TAB BAR ========== */
    .mobile-tab-bar {
      display: none;
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 200;
      background: var(--dark);
      border-top: 1px solid rgba(255, 244, 206, 0.08);
      padding: 0.5rem 0 calc(0.5rem + env(safe-area-inset-bottom, 0px));
    }
    .mobile-tab-bar__links { display: flex; justify-content: space-around; align-items: center; list-style: none; padding: 0 0.25rem; }
    .mobile-tab-bar__link { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; text-decoration: none; color: var(--cream); opacity: 0.45; transition: opacity 0.2s; padding: 0.3rem 0.2rem; flex: 1 1 0; min-width: 0; }
    .mobile-tab-bar__link.active { opacity: 1; }
    .mobile-tab-bar__link svg { width: 19px; height: 19px; flex-shrink: 0; }
    .mobile-tab-bar__label { font-family: var(--font-sans); font-size: 0.52rem; line-height: 1; letter-spacing: 0.035em; text-transform: uppercase; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 768px) {
      .site-header { padding: 1.2rem 1.5rem; }
      .header-nav > li:not(.header-nav__about) { display: none; }
      .mobile-tab-bar { display: block; }
      body { padding-bottom: 5rem; }
      .hero__content { padding: 0 1.5rem calc(5.75rem + env(safe-area-inset-bottom, 0px)); }
      .notify { padding: 5rem 1.5rem; }
      .notify__form { flex-direction: column; }
      .notify__button { padding: 1rem; }
      .contact { padding: 3rem 1.5rem 4rem; }
      .contact__row { flex-direction: column; }
      .contact__type-selector { gap: 0.5rem; }
      .contact__type-btn { padding: 0.6rem 1.2rem; font-size: 0.75rem; }
      .contact__submit { align-self: stretch; }
      .site-footer { padding: 3rem 1.5rem 1.5rem; }
      .footer__top { flex-direction: column; gap: 2rem; }
      .footer__bottom { flex-direction: column; gap: 1rem; }
    }

    /* ========== ANIMATIONS ========== */
    .fade-in {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    .fade-in.visible { opacity: 1; transform: translateY(0); }

    @keyframes heroFadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .hero__badge { animation: heroFadeUp 0.8s ease 0.3s both; }
    .hero__heading { animation: heroFadeUp 0.8s ease 0.5s both; }
    .hero__sub { animation: heroFadeUp 0.8s ease 0.7s both; }

    .site-header::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(42, 2, 8, 0.5), transparent);
      z-index: -1;
      pointer-events: none;
      transition: opacity 0.4s;
    }
    .site-header.scrolled::before { opacity: 0; }
  </style>
</head>
<body>
  {% section 'header' %}
  <main>
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}

  <script>
    // Header scroll effect. Passive listener + rAF coalescing: scrolling never
    // waits on JS, and we touch the DOM at most once per frame instead of on
    // every scroll event (matters most in slow in-app browsers / on mobile).
    const header = document.getElementById('siteHeader');
    if (header) {
      let scrollTicking = false;
      const updateHeader = () => {
        header.classList.toggle('scrolled', window.scrollY > 60);
        scrollTicking = false;
      };
      window.addEventListener('scroll', () => {
        if (!scrollTicking) {
          scrollTicking = true;
          requestAnimationFrame(updateHeader);
        }
      }, { passive: true });
    }

    // Scroll fade-in. Unobserve once shown so the observer stops firing for
    // elements that have already animated in.
    const fadeEls = document.querySelectorAll('.fade-in');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    fadeEls.forEach(el => observer.observe(el));

    // Mailchimp removed the JSONP /subscribe/post-json endpoint (now 404s).
    // Submit cross-origin via sendBeacon (fire-and-forget, instant) with a
    // no-cors fetch fallback. Response is opaque either way, so we treat a
    // queued/sent request as success. Matches Mailchimp's stock embed behavior.
    window.KynNewsletter = window.KynNewsletter || (function() {
      const endpoint = 'https://kynskyn.us15.list-manage.com/subscribe/post';
      const listParams = 'u=61338503f23a719d2d581c864&id=051996d936';
      const honeypotName = 'b_61338503f23a719d2d581c864_051996d936';
      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function submit(options) {
        const email = (options && options.email ? options.email : '').trim();
        const source = (options && options.source ? options.source : 'site-newsletter').trim();

        if (!emailPattern.test(email)) {
          return Promise.reject(new Error('Enter a valid email address.'));
        }

        const body = new FormData();
        body.append('EMAIL', email);
        body.append('SOURCE', source);
        body.append(honeypotName, '');

        const url = endpoint + '?' + listParams;

        if (navigator.sendBeacon && navigator.sendBeacon(url, body)) {
          return Promise.resolve({ ok: true });
        }

        return fetch(url, { method: 'POST', mode: 'no-cors', body: body, keepalive: true })
          .then(() => ({ ok: true }))
          .catch(() => {
            throw new Error('That did not go through. Please check your connection and try again.');
          });
      }

      return { submit: submit };
    })();
  </script>

  <!-- ====== MOBILE TAB BAR ====== -->
  <nav class="mobile-tab-bar" aria-label="Primary mobile navigation">
    <ul class="mobile-tab-bar__links">
      <li>
