  <!-- Google Ads (gtag.js) + Microsoft UET load lazily: their queues are stubbed
       synchronously so early events buffer, and the libraries themselves load
       after first paint (first interaction, or a ~2.5s idle fallback) to keep the
       critical path clear in slow in-app browsers (Instagram/TikTok on iOS). The
       Meta Pixel and Endorsely load eagerly so ad attribution and affiliate
       referral capture are never delayed. -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'AW-18211322785');
    window.uetq = window.uetq || [];

    (function () {
      var loaded = false;
      var events = ['pointerdown', 'touchstart', 'scroll', 'keydown'];

      // Meta Pixel. Loads eagerly (unlike the gtag/UET tags below) so ad
      // attribution and PageView capture stay complete, including fast bounces.
      // To deactivate, blank metaPixelId: window.fbq stays undefined and
      // consultation.liquid's InitiateCheckout no-ops.
      var metaPixelId = '943159622092998';
      if (metaPixelId) {
        // Standard Meta base pixel: this stub injects fbevents.js immediately.
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', metaPixelId);
        window.fbq('track', 'PageView');
      }

      function loadTags() {
        if (loaded) return;
        loaded = true;
        events.forEach(function (e) { window.removeEventListener(e, loadTags); });

        // Google Ads gtag.js
        var g = document.createElement('script');
        g.async = true;
        g.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18211322785';
        document.head.appendChild(g);

        // Microsoft Advertising UET (official bootstrap; flushes the uetq queue)
        (function (w, d, t, u, o) {
          w[u] = w[u] || [];
          o.ts = (new Date).getTime();
          var n = d.createElement(t);
          n.src = "https://bat.bing.net/bat.js?ti=" + o.ti + ("uetq" != u ? "&q=" + u : "");
          n.async = 1;
          n.onload = n.onreadystatechange = function () {
            var s = this.readyState;
            s && "loaded" !== s && "complete" !== s || (o.q = w[u], w[u] = new UET(o), w[u].push("pageLoad"), n.onload = n.onreadystatechange = null);
          };
          var i = d.getElementsByTagName(t)[0];
          i.parentNode.insertBefore(n, i);
        })(window, document, "script", "uetq", { ti: "97250212", enableAutoSpaTracking: true });
      }

      events.forEach(function (e) { window.addEventListener(e, loadTags, { passive: true }); });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadTags, { timeout: 2500 });
      } else {
        setTimeout(loadTags, 2500);
      }
    })();
  </script>

  <!-- Meta Pixel <noscript> fallback (PageView for JS-disabled loads) -->
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=943159622092998&ev=PageView&noscript=1" alt=""/></noscript>

  <!-- Endorsely affiliate tracking. Resolves the ?via= referral for the visitor
       and exposes it on window.endorsely_referral (+ an endorsely_referral
       cookie); the care app stamps it into Stripe metadata for attribution. Same
       program id as the care app's EndorselyScript so one click attributes across
       the storefront and care.kynskyn.com. -->
  <script async src="https://assets.endorsely.com/endorsely.js" data-endorsely="6b182976-e104-4238-9dbb-e2de10b7a7fd"></script>
  <script>
    window.KynAttribution = (function() {
      var ATTR_KEY = 'kyn_attribution_context';
      var CART_SYNC_KEY = 'kyn_cart_attribution_synced_at';
      var FUNNEL_SESSION_KEY = 'kyn_fs';

      function readJson(key) {
        try { return JSON.parse(window.localStorage.getItem(key) || '{}'); }
        catch (err) { return {}; }
      }

      function writeJson(key, value) {
        try { window.localStorage.setItem(key, JSON.stringify(value)); }
        catch (err) {}
      }

      function read() {
        return readJson(ATTR_KEY);
      }

      function sessionId() {
        try {
          var value = window.localStorage.getItem(FUNNEL_SESSION_KEY);
          if (!value) {
            value = (window.crypto && crypto.randomUUID)
              ? crypto.randomUUID()
              : ('s_' + Date.now() + '_' + Math.random().toString(36).slice(2));
            window.localStorage.setItem(FUNNEL_SESSION_KEY, value);
          }
          return String(value).slice(0, 64);
        } catch (err) {
          return 'nostore_' + Math.random().toString(36).slice(2);
        }
      }

      function cleanToken(value) {
        return String(value || '')
          .trim()
          .toLowerCase()
          .replace(/^https?:\/\//, '')
          .replace(/^www\./, '')
          .replace(/[^a-z0-9._-]+/g, '_')
          .replace(/^_+|_+$/g, '')
          .slice(0, 64);
      }

      function referrerHost(value) {
        try {
          return new URL(value).hostname.toLowerCase().replace(/^www\./, '').slice(0, 100);
        } catch (err) {
          return '';
        }
      }

      function normalizeTrafficSource(value) {
        var token = cleanToken(value);
        if (!token) return '';
        if (/(^|[._-])(ig|instagram)([._-]|$)|instagram\.com/.test(token)) return 'instagram';
        if (/(^|[._-])(fb|facebook|meta)([._-]|$)|facebook\.com|fb\.com/.test(token)) return 'facebook';
        if (/tiktok|tiktok\.com/.test(token)) return 'tiktok';
        if (/google|google\.com|gclid/.test(token)) return 'google';
        if (/bing|microsoft|msclkid/.test(token)) return 'bing';
        if (/youtube|youtu\.be/.test(token)) return 'youtube';
        if (/email|newsletter|klaviyo/.test(token)) return 'email';
        if (/affiliate|creator|influencer/.test(token)) return 'affiliate';
        if (/direct|none|unknown/.test(token)) return 'direct';
        return token;
      }

      function capture() {
        var params = new URLSearchParams(window.location.search);
        var existing = read();

        var next = Object.assign({}, existing, {
          landing_url: existing.landing_url || window.location.href,
          last_url: window.location.href,
          referrer: existing.referrer || document.referrer || '',
          captured_at: existing.captured_at || new Date().toISOString()
        });

        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function(key) {
          var value = params.get(key);
          if (value) next[key] = value.slice(0, 160);
        });

        // Sourced from Endorsely (window.endorsely_referral). Kept under the
        // legacy `affiliatebase_referral` key so the funnel beacon, cart
        // attributes, and Shopify order webhook stay unchanged.
        if (window.endorsely_referral) {
          next.affiliatebase_referral = String(window.endorsely_referral).slice(0, 160);
        }

        writeJson(ATTR_KEY, next);
        return next;
      }

      function trafficAttribution() {
        var params = new URLSearchParams(window.location.search);
        var ctx = capture();
        var refHost = referrerHost(ctx.referrer || document.referrer || '');
        var out = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function(key) {
          if (ctx[key]) out[key] = String(ctx[key]).slice(0, 120);
        });
        if (refHost) out.referrer_host = refHost;
        if (ctx.affiliatebase_referral) out.affiliatebase_referral = String(ctx.affiliatebase_referral).slice(0, 120);
        out.traffic_source =
          normalizeTrafficSource(params.get('traffic_source')) ||
          normalizeTrafficSource(ctx.utm_source) ||
          (params.get('gclid') || params.get('gbraid') || params.get('wbraid') ? 'google' : '') ||
          (params.get('msclkid') ? 'bing' : '') ||
          (params.get('ttclid') ? 'tiktok' : '') ||
          (params.get('fbclid') ? 'facebook' : '') ||
          normalizeTrafficSource(refHost) ||
          'direct';
        return out;
      }

      function compactContext(extra) {
        var ctx = Object.assign({}, read(), extra || {});
        var out = {};
        [
          'affiliatebase_referral',
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_term',
          'utm_content',
          'landing_url',
          'referrer',
          'kyn_care_plan',
          'kyn_care_handoff_token'
        ].forEach(function(key) {
          if (ctx[key]) out[key] = String(ctx[key]).slice(0, 500);
        });
        return out;
      }

      async function syncCartAttributes(extra) {
        var ctx = compactContext(extra);
        var attrs = {
          kyn_checkout_source: 'shopify_care_funnel',
          kyn_affiliatebase_referral: ctx.affiliatebase_referral || '',
          kyn_care_plan: ctx.kyn_care_plan || '',
          kyn_care_handoff_token: ctx.kyn_care_handoff_token || '',
          kyn_attribution: JSON.stringify(ctx)
        };

        try {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ attributes: attrs })
          });
          window.localStorage.setItem(CART_SYNC_KEY, String(Date.now()));
        } catch (err) {}

        return attrs;
      }

      function appendToUrl(url, extra) {
        var target = new URL(url, window.location.origin);
        var ctx = compactContext(extra);
        if (ctx.affiliatebase_referral) target.searchParams.set('affiliatebase_referral', ctx.affiliatebase_referral);
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function(key) {
          if (ctx[key]) target.searchParams.set(key, ctx[key]);
        });
        return target.toString();
      }

      document.addEventListener('DOMContentLoaded', capture);
      window.addEventListener('load', function() {
        setTimeout(capture, 500);
      });

      return {
        capture: capture,
        read: read,
        sessionId: sessionId,
        trafficAttribution: trafficAttribution,
        syncCartAttributes: syncCartAttributes,
        appendToUrl: appendToUrl
      };
    })();
  </script>
