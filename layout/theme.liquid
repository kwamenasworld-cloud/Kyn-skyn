  <style>
    /* ========== FONT FACES ========== */
    @font-face {
      font-family: 'STK Bureau Serif';
      src: url('{{ "STKBureauSerif-Light.woff2" | asset_url }}') format('woff2');
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'STK Bureau Serif';
      src: url('{{ "STKBureauSerif-Book.woff2" | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'STK Bureau Sans';
      src: url('{{ "STKBureauSans-Book.woff2" | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'ABC Maxi Sharp';
      src: url('{{ "ABCMaxiSharp-Regular.woff2" | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    /* ========== RESET & BASE ========== */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* <picture> wrappers (WebP source + JPG fallback) must not generate a box,
       so the inner <img> keeps inheriting its container's sizing rules. */
    picture { display: contents; }

    :root {
      --cream: #fff4ce;
      --maroon: #641220;
      --dark: #2a0208;
      --button: #7e1029;
      --terracotta: #c75b2a;
      --gold: #d4952a;
      --font-serif: 'STK Bureau Serif', Georgia, serif;
      --font-sans: 'STK Bureau Sans', 'Helvetica Neue', Arial, sans-serif;
      --font-accent: 'ABC Maxi Sharp', 'STK Bureau Sans', sans-serif;
    }

    html {
      scroll-behavior: smooth;
      overflow-x: hidden;
      overflow-x: clip;
    }

    body {
      font-family: var(--font-sans);
      color: var(--maroon);
      background: var(--cream);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      overflow-x: clip;
      position: relative;
      width: 100%;
    }

    main { overflow-x: hidden; overflow-x: clip; width: 100%; }

    /* ========== HEADER ========== */
    .site-header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 1.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.4s ease;
    }

    .site-header.scrolled {
      background: rgba(42, 2, 8, 0.92);
      backdrop-filter: blur(12px);
    }

    .header-nav {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .header-nav a {
      color: var(--cream);
      text-decoration: none;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.85;
      transition: opacity 0.3s;
    }

    .header-nav a:hover { opacity: 1; }

    /* Dropdown nav (Resources, Get Care) */
    .header-nav__group { position: static; }

    .header-nav__group > a {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    /* Hover bridge: invisible strip directly below the trigger link only,
       reaching down to the dropdown panel. Keeps the dropdown open while
       the cursor crosses the gap, without blocking pointer events on
       sibling nav items (Shop, Contact, etc.). */
    .header-nav__group > a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 1.5rem;
    }

    .header-nav__caret {
      width: 10px; height: 10px;
      transition: transform 0.2s ease;
    }

    .header-nav__group:hover .header-nav__caret,
    .header-nav__group:focus-within .header-nav__caret {
      transform: rotate(-180deg);
    }

    /* Full-width dropdown panel, flush with the bottom of the fixed header */
    .header-nav__dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 99;
      list-style: none;
      margin: 0;
      padding: 1.6rem 3rem;
      background: rgba(42, 2, 8, 0.96);
      backdrop-filter: blur(14px);
      border-top: 1px solid rgba(255, 244, 206, 0.08);
      box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.55);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(0.4rem);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;

      display: flex;
      justify-content: center;
      gap: 1rem;
    }

    .header-nav__group:hover .header-nav__dropdown,
    .header-nav__group:focus-within .header-nav__dropdown {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
    }

    /* Header darkens while a dropdown is open so the panel feels attached */
    .site-header:has(.header-nav__group:hover),
    .site-header:has(.header-nav__group:focus-within) {
      background: rgba(42, 2, 8, 0.96);
      backdrop-filter: blur(14px);
    }

    /* Hover bridge lives on the trigger link (.header-nav__group > a::after)
       so it doesn't span the full header width and block clicks on sibling
       nav items like Shop/Contact. */

    .header-nav__dropdown li { margin: 0; flex: 0 0 auto; }

    .header-nav__dropdown a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
      padding: 0.85rem 1.5rem;
      min-width: 9rem;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      text-transform: none;
      text-align: center;
      white-space: nowrap;
      border-radius: 8px;
      opacity: 0.78;
      transition: background 0.2s ease, opacity 0.2s ease;
    }

    .header-nav__dropdown a:hover {
      opacity: 1;
      background: rgba(212, 149, 42, 0.08);
    }

    .header-nav__dropdown-icon {
      width: 28px;
      height: 28px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      color: var(--gold);
    }

    .header-logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      text-decoration: none;
      display: block;
    }

    .header-logo svg {
      height: 28px;
      width: auto;
      color: var(--cream);
      fill: var(--cream);
    }

    /* ========== HERO ========== */
    .hero {
      position: relative;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      overflow: hidden;
    }

    .hero__bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    .hero__gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(100, 18, 32, 0.0) 40%,
        rgba(42, 2, 8, 0.6) 70%,
        rgba(42, 2, 8, 0.92) 100%
      );
      z-index: 1;
    }

    .hero__content {
      position: relative;
      z-index: 2;
      padding: 0 3rem 5rem;
      max-width: 72rem;
    }

    .hero__badge {
      display: inline-block;
      font-family: var(--font-accent);
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--cream);
      margin-bottom: 1.8rem;
      border: 1.5px solid rgba(255, 244, 206, 0.45);
      padding: 0.6rem 1.6rem;
      border-radius: 2rem;
      background: rgba(42, 2, 8, 0.35);
      backdrop-filter: blur(6px);
    }

    .hero__heading {
      font-family: var(--font-serif);
      font-size: clamp(3rem, 7vw, 5.5rem);
      font-weight: 400;
      line-height: 1.05;
      color: var(--cream);
      margin-bottom: 1.2rem;
    }

    .hero__heading-plus {
      display: inline-block;
      color: var(--terracotta);
      font-family: var(--font-accent);
      font-weight: 400;
      font-size: 0.7em;
      line-height: 1;
      margin: 0 0.18em;
      vertical-align: 0.08em;
      transform-origin: 50% 55%;
      animation: heroPlusSpin 14s linear infinite;
    }

    @keyframes heroPlusSpin {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__heading-plus { animation: none; transform: rotate(-8deg); }
    }

    .hero__sub {
      font-family: var(--font-sans);
      font-size: clamp(1.4rem, 3vw, 1.85rem);
      font-weight: 300;
      color: var(--gold);
      opacity: 0.95;
      max-width: 36rem;
      line-height: 1.6;
    }

    .hero__conditions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.9rem;
      max-width: 36rem;
    }

    .hero__condition-tile {
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.85rem;
      border: 1px solid rgba(255, 244, 206, 0.3);
      border-radius: 999px;
      background: rgba(255, 244, 206, 0.04);
      backdrop-filter: blur(4px);
      font-family: var(--font-sans);
      font-size: clamp(0.72rem, 1.05vw, 0.82rem);
      font-weight: 500;
      color: var(--cream);
      letter-spacing: 0.04em;
      opacity: 0.85;
    }

    .hero__cta-wrap {
      position: relative;
      display: inline-block;
      margin-top: 2.5rem;
    }

    .hero__badge.hero__badge--sticker {
      position: absolute;
      top: -14px;
      left: -12px;
      transform: rotate(-7deg);
      transform-origin: center;
      z-index: 3;
      margin: 0;
      background: var(--dark);
      border-color: rgba(255, 244, 206, 0.35);
      font-size: 0.7rem;
      padding: 0.5rem 1.15rem;
      box-shadow: 0 6px 18px -6px rgba(42, 2, 8, 0.7);
      pointer-events: none;
      animation: stickerPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.5s both,
                 stickerWiggle 6s ease-in-out 2s infinite;
    }

    @keyframes stickerPop {
      from { opacity: 0; transform: rotate(-20deg) scale(0.7); }
      to   { opacity: 1; transform: rotate(-7deg) scale(1); }
    }

    @keyframes stickerWiggle {
      0%, 100% { transform: rotate(-7deg) translateY(0); }
      50%      { transform: rotate(-5deg) translateY(-2px); }
    }

    .hero__cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 1.1rem 2rem 1.1rem 1.5rem;
      background: var(--cream);
      color: var(--maroon);
      font-family: var(--font-accent);
      font-size: 0.95rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 999px;
      isolation: isolate;
      box-shadow: 0 10px 30px -10px rgba(42, 2, 8, 0.55);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      will-change: transform;
    }

    .hero__cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 40px -12px rgba(42, 2, 8, 0.7);
    }

    .hero__cta:focus-visible {
      outline: 2px solid var(--cream);
      outline-offset: 4px;
    }

    .hero__cta-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background: var(--terracotta);
      box-shadow: 0 0 0 0 rgba(199, 91, 42, 0.55);
      animation: heroCtaPulse 2.2s ease-out infinite;
      flex-shrink: 0;
    }

    .hero__cta-arrow {
      width: 18px;
      height: 18px;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    .hero__cta:hover .hero__cta-arrow { transform: translateX(4px); }

    @keyframes heroCtaPulse {
      0%   { box-shadow: 0 0 0 0 rgba(199, 91, 42, 0.55); }
      70%  { box-shadow: 0 0 0 10px rgba(199, 91, 42, 0); }
      100% { box-shadow: 0 0 0 0 rgba(199, 91, 42, 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__cta,
      .hero__cta-dot,
      .hero__cta-arrow { animation: none; transition: none; }
    }

    @media (max-width: 640px) {
      .hero__cta {
        font-size: 0.8rem;
        padding: 0.95rem 1.6rem 0.95rem 1.25rem;
        letter-spacing: 0.09em;
      }
    }

    .hero__price {
      margin-top: 1.4rem;
      max-width: 34rem;
      font-family: var(--font-sans);
      font-size: clamp(0.92rem, 1.4vw, 1.05rem);
      font-weight: 400;
      line-height: 1.55;
      color: var(--cream);
      opacity: 0.92;
    }

    .hero__price strong {
      font-weight: 600;
      color: var(--gold);
    }

    /* ========== NOTIFY ========== */
    .notify {
      background: var(--dark);
      padding: 8rem 3rem;
      position: relative;
      overflow: hidden;
    }

    .notify__grid-bg {
      position: absolute;
      inset: 0;
      opacity: 0.06;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .notify__grid-bg svg {
      width: 60%;
      height: auto;
      color: var(--cream);
    }

    .notify__container {
      max-width: 48rem;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .notify__eyebrow {
      font-family: var(--font-accent);
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--cream);
      opacity: 0.5;
      margin-bottom: 2rem;
    }

    .notify__heading {
      font-family: var(--font-serif);
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 400;
      color: var(--cream);
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }

    .notify__desc {
      font-family: var(--font-sans);
      font-size: 1.1rem;
      color: var(--cream);
