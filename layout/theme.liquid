    }

    .notify__form:focus-within { border-color: rgba(255, 244, 206, 0.5); }

    .notify__input {
      flex: 1;
      background: transparent;
      border: none;
      padding: 1rem 1.5rem;
      color: var(--cream);
      font-family: var(--font-sans);
      font-size: 0.9rem;
      outline: none;
    }

    .notify__input::placeholder { color: rgba(255, 244, 206, 0.4); }

    .notify__button {
      background: var(--button);
      color: var(--cream);
      border: none;
      padding: 1rem 2rem;
      font-family: var(--font-sans);
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
