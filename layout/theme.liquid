      line-height: 1.7;
      margin-bottom: 3rem;
      max-width: 32rem;
      margin-left: auto;
      margin-right: auto;
    }

    .notify__form {
      display: flex;
      gap: 0;
      max-width: 28rem;
      margin: 0 auto;
      border: 1px solid rgba(255, 244, 206, 0.2);
